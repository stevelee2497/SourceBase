@page "/roles"
@attribute [Authorize(Roles = "Admin")]
@inject ApiHttpClient Api

<div class="flex items-center justify-between mb-6">
    <button class="btn-primary" @onclick="OpenCreate" disabled="@_loading">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>New Role</span>
    </button>
    <button class="btn-secondary" @onclick="LoadRolesAsync" disabled="@_loading" title="Reload">
        <svg class="w-4 h-4 @(_loading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
}

@if (_loading)
{
    <LoadingSpinner />
}
else if (_data is not null)
{
    <div class="card p-0 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-900">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Description</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var role in _data.Items)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-4 py-3">
                                <span class="font-medium text-md text-gray-900 dark:text-gray-100">@role.Name</span>
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">@(role.Description ?? "—")</td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-3">
                                    @if (role.Name == "Admin")
                                    {
                                        <span class="text-green-500 dark:text-green-400" title="system">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                                            </svg>
                                        </span>
                                    }
                                    <button class="text-gray-400 dark:text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled="@(role.Name == "Admin")" @onclick="OpenEdit(role)" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button class="text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-400 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled="@(role.Name == "Admin")" @onclick="ConfirmDelete(role)" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Pagination CurrentPage="_page" TotalItems="_data.Total" PageSize="_pageSize" OnPageChanged="ChangePage" />
}

<!-- Create / Edit Modal -->
@if (_showForm)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseForm"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">@(_editingRole is null ? "Create Role" : "Edit Role")</h2>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_formError</div>
            }

            <div class="space-y-4">
                <div>
                    <label class="form-label">Name *</label>
                    <input @bind="_form.Name" class="form-input" placeholder="e.g. Editor" />
                </div>
                <div>
                    <label class="form-label">Description</label>
                    <input @bind="_form.Description" class="form-input" placeholder="Optional description" />
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button class="btn-secondary" @onclick="CloseForm">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
                <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="_showDelete" Title="Delete role" Message="@($"Are you sure you want to delete '{_deletingRole?.Name}'? Users with this role will lose it.")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    private PagingResponse<RoleResponse>? _data;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private const int _pageSize = 10;

    // Form state
    private bool _showForm;
    private RoleResponse? _editingRole;
    private readonly RoleFormModel _form = new();
    private string? _formError;
    private bool _saving;

    // Delete state
    private bool _showDelete;
    private RoleResponse? _deletingRole;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _loading = true;
        _error = null;
        var (data, error) = await Api.GetRolesAsync(_page, _pageSize);
        _data = data;
        if (error is not null)
            _error = "Failed to load roles.";
        _loading = false;
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadRolesAsync();
    }

    private void OpenCreate()
    {
        _editingRole = null;
        _form.Name = _form.Description = string.Empty;
        _formError = null;
        _showForm = true;
    }

    private Action OpenEdit(RoleResponse role) => () =>
    {
        _editingRole = role;
        _form.Name = role.Name;
        _form.Description = role.Description ?? string.Empty;
        _formError = null;
        _showForm = true;
    };

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        _formError = null;
        _saving = true;
        var error = _editingRole is null
            ? await Api.CreateRoleAsync(_form.Name, string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description)
            : await Api.UpdateRoleAsync(_editingRole.Id, _form.Name, string.IsNullOrWhiteSpace(_form.Description) ? null :
_form.Description);

        if (error is not null)
        {
            _formError = error.Message ?? "Failed to save role. Please try again.";
            _saving = false;
            return;
        }

        _showForm = false;
        await LoadRolesAsync();
        _saving = false;
    }

    private Action ConfirmDelete(RoleResponse role) => () =>
    {
        _deletingRole = role;
        _showDelete = true;
    };

    private void CancelDelete()
    {
        _showDelete = false;
        _deletingRole = null;
    }

    private async Task DeleteAsync()
    {
        if (_deletingRole is null) return;
        _showDelete = false;
        var error = await Api.DeleteRoleAsync(_deletingRole.Id);
        if (error is not null)
            _error = "Failed to delete role.";
        else
            await LoadRolesAsync();
        _deletingRole = null;
    }

    private sealed class RoleFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
