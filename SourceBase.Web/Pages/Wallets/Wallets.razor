@page "/wallets"
@attribute [Authorize]
@inject ApiHttpClient Api

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
}

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <!-- Layout: 1 columns as default, 2 when lg screen -->
    <div class="flex flex-col lg:flex-row gap-0 lg:gap-4 mb-6">
        <div class="flex flex-1 flex-col gap-4">
            <!-- Total Balance card (clickable to deselect all wallets) -->
            <div class="card bg-linear-to-r from-indigo-600 to-indigo-500 text-white cursor-pointer transition-all @(_selectedWalletIds.Count == 0 ? "ring-4 ring-white/40" : "hover:opacity-90")" @onclick="SelectAllWallets">
                <div class="text-sm font-medium text-indigo-100 mb-2">Total Balance</div>
                <div class="text-3xl sm:text-4xl font-bold">@FormatAmount(_totalBalance)</div>
            </div>

            <!-- Pie chart -->
            @if (_wallets.Count > 0)
            {
                <div class="card flex flex-col sm:flex-row items-center gap-4 py-3 px-5">
                    <div class="shrink-0">
                        @{
                            var pieData = BuildPieData();
                        }
                        <svg width="140" height="140" viewBox="-1 -1 2 2" style="transform: rotate(-90deg)">
                            @if (pieData.Count == 1)
                            {
                                <circle cx="0" cy="0" r="1" fill="@pieData[0].Color" />
                            }
                            else
                            {
                                double cumulative = 0;
                                foreach (var slice in pieData)
                                {
                                    var startAngle = cumulative * 2 * Math.PI;
                                    cumulative += slice.Fraction;
                                    var endAngle = cumulative * 2 * Math.PI;
                                    var x1 = Math.Cos(startAngle);
                                    var y1 = Math.Sin(startAngle);
                                    var x2 = Math.Cos(endAngle);
                                    var y2 = Math.Sin(endAngle);
                                    var largeArc = slice.Fraction > 0.5 ? 1 : 0;
                                    var pathD = $"M 0 0 L {x1:F4} {y1:F4} A 1 1 0 {largeArc} 1 {x2:F4} {y2:F4} Z";
                                    <path d="@pathD" fill="@slice.Color" stroke="white" stroke-width="0.02" />
                                }
                            }
                        </svg>
                    </div>
                    <div class="flex flex-col gap-3 flex-1 justify-center items-center">
                        <div class="flex flex-wrap gap-x-4 gap-y-1 justify-center">
                            @{
                                var legendData = BuildPieData();
                            }
                            @foreach (var slice in legendData)
                            {
                                <div class="flex items-center gap-1.5 text-xs">
                                    <div class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: @slice.Color"></div>
                                    <span class="text-gray-700 dark:text-gray-200 font-medium">@slice.Name</span>
                                    <span class="text-gray-400 dark:text-gray-500">@((slice.Fraction * 100).ToString("F1"))%</span>
                                </div>
                            }
                        </div>
                        @{
                            var selectedWalletList = _selectedWalletIds.Count > 0 ? _wallets.Where(w => _selectedWalletIds.Contains(w.Id)).ToList() : _wallets;
                            var selectedBalance = selectedWalletList.Sum(w => w.Balance);
                        }
                        <div class="border-t border-gray-100 dark:border-gray-700 w-full text-center">
                            <div class="text-sm text-gray-400 dark:text-gray-500 mt-1">@(_selectedWalletIds.Count > 0 ? "Selected balance" : "Total balance")</div>
                            <div class="text-lg font-bold text-gray-900 dark:text-gray-100">@FormatAmount(selectedBalance)</div>
                        </div>
                    </div>
                </div>
            }

            <div class="grid grid-cols-2 gap-2">
                <div class="rounded-lg bg-green-50 dark:bg-green-900/30 px-4 py-3">
                    <div class="text-xs text-green-600 dark:text-green-400 font-medium mb-0.5">Monthly Income</div>
                    <div class="text-xl font-bold text-green-700 dark:text-green-400">@FormatAmount(_summary?.TotalIncome ?? 0)</div>
                </div>
                <div class="rounded-lg bg-red-50 dark:bg-red-900/30 px-4 py-3">
                    <div class="text-xs text-red-600 dark:text-red-400 font-medium mb-0.5">Monthly Expense</div>
                    <div class="text-xl font-bold text-red-700 dark:text-red-400">@FormatAmount(_summary?.TotalExpense ?? 0)</div>
                </div>
            </div>

            <!-- Wallets grid (3 per row mobile, 6 per row desktop) -->
            <div class="grid grid-cols-3 gap-2 mb-3">
                @foreach (var wallet in _wallets)
                {
                    var isSelected = _selectedWalletIds.Contains(wallet.Id);
                    <div class="relative rounded-lg border-2 @(isSelected ? "border-indigo-500 bg-indigo-50 dark:bg-indigo-900/30" : "border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-indigo-300 hover:bg-gray-50 dark:hover:bg-gray-700") cursor-pointer transition-all p-2 md:p-3 flex flex-col gap-1 md:gap-1.5 justify-between" @onclick="SelectWallet(wallet.Id)">
                        <div class="absolute top-1.5 right-1.5 flex gap-1">
                            <button class="text-gray-400 dark:text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400" @onclick:stopPropagation @onclick="OpenEditWallet(wallet)" title="Edit">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </button>
                            <button class="text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-400" @onclick:stopPropagation @onclick="ConfirmDeleteWallet(wallet)" title="Delete">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                        <div class="flex items-center justify-start gap-1">
                            <span class="text-xl leading-none">
                                @if (wallet.Icon?.StartsWith("http") == true)
                                {
                                    <img src="@wallet.Icon" class="w-6 h-6 object-contain" alt="wallet icon" />
                                }
                                else if (wallet.Icon?.TrimStart().StartsWith("<") == true)
                                {
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor">@((MarkupString)wallet.Icon)</svg>
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(wallet.Icon) ? "👛" : wallet.Icon)
                                }
                            </span>
                        </div>
                        <div class="text-xs font-semibold @(isSelected ? "text-indigo-700 dark:text-indigo-400" : "text-gray-700 dark:text-gray-200") truncate">@wallet.Name</div>
                        <div class="text-sm font-bold @(isSelected ? "text-indigo-700 dark:text-indigo-400" : "text-gray-900 dark:text-gray-100")">@FormatAmount(wallet.Balance)</div>
                    </div>
                }
                <div class="rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 cursor-pointer transition-all p-3 flex flex-col items-center justify-center gap-1.5 text-gray-400 dark:text-gray-500 hover:text-indigo-500 dark:hover:text-indigo-400" @onclick="OpenCreateWallet">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span class="text-xs font-medium">Add Wallet</span>
                </div>
            </div>
        </div>
        <div class="flex-1">
            <!-- Summary -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                <div>
                    @if (_selectedWalletIds.Count == 0)
                    {
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">All Transactions</h2>
                        <div class="text-sm text-gray-500 dark:text-gray-400">Showing transactions across all wallets</div>
                    }
                    else if (_selectedWallet is not null)
                    {
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">@_selectedWallet.Name</h2>
                        <div class="text-sm text-gray-500 dark:text-gray-400">Balance: <span class="font-semibold text-gray-900 dark:text-gray-100">@FormatAmount(_selectedWallet.Balance) @_selectedWallet.Currency</span></div>
                    }
                    else
                    {
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Selected Wallets</h2>
                        <div class="text-sm text-gray-500 dark:text-gray-400">Showing transactions for @_selectedWalletIds.Count wallets</div>
                    }
                </div>
            </div>

            <!-- Filters -->
            <div class="mb-4 flex flex-col gap-3">
                <div class="flex flex-wrap gap-2">
                    <button class="@TypeFilterClass(string.Empty)" @onclick="ResetFiltersAsync">All</button>
                    <button class="@TypeFilterClass(IncomeType)" @onclick="ToggleTypeFilter(IncomeType)">Income</button>
                    <button class="@TypeFilterClass(ExpenseType)" @onclick="ToggleTypeFilter(ExpenseType)">Expense</button>
                    <MultiSelectInput @bind-Values="_categoryFilterIds" @bind-Values:after="ApplyFiltersAsync" Options="CategoryFilterOptions" Placeholder="All categories" />
                    <MultiSelectInput @bind-Values="_dateRangeFilters" @bind-Values:after="OnDateRangeFilterChangedAsync" Options="DateRangeOptions" Placeholder="All time" />
                </div>
            </div>

            <!-- Buttons -->
            <div class="grid grid-cols-2 gap-2 mb-4">
                <button class="btn-primary btn w-full" @onclick="OpenCreateTransaction">
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Add Transaction
                </button>
                <button class="btn-secondary btn w-full" @onclick="OpenCreateTransfer">
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l-4-4m4 4l4-4" />
                    </svg>
                    Transfer
                </button>
            </div>

            <!-- Transactions -->
            <div class="card px-3 py-1">
                @if (_loadingTransactions && _transactions.Count == 0)
                {
                    <LoadingSpinner />
                }
                else if (!_loadingTransactions && _transactions.Count == 0)
                {
                    <div class="text-sm text-gray-400 dark:text-gray-500 py-8 text-center">No transactions found.</div>
                }
                else if (_transactions.Count > 0)
                {
                    <div class="relative">
                        @if (_loadingTransactions)
                        {
                            <div class="absolute inset-0 z-10 flex items-start justify-center pt-10 bg-white/40 dark:bg-gray-900/40 rounded">
                                <LoadingSpinner />
                            </div>
                        }
                        <div class="@(_loadingTransactions ? "blur-sm pointer-events-none select-none" : "") flex flex-col divide-y divide-gray-100 dark:divide-gray-700">
                            @foreach (var transaction in _transactions)
                            {
                                <div class="py-2 flex flex-col sm:flex-row sm:items-center gap-2 @(!transaction.IsTransfer ? "cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700" : "")" @onclick="RowClick(transaction)">
                                    <div class="flex items-center gap-3 flex-1 min-w-0">
                                        <div class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-700/50 flex items-center justify-center text-lg shrink-0">
                                            @{
                                                var txIcon = TransactionIcon(transaction);
                                            }
                                            @if (txIcon.StartsWith("http"))
                                            {
                                                <img src="@txIcon" class="w-6 h-6 object-contain" alt="category icon" />
                                            }
                                            else
                                            {
                                                @((MarkupString)txIcon)
                                            }
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="font-medium text-gray-900 dark:text-gray-100 truncate">@TransactionCategoryLabel(transaction)</div>
                                            <div class="text-sm text-gray-500 dark:text-gray-400 truncate flex">
                                                @TransactionTitle(transaction)
                                                <div class="ml-1 flex flex-wrap items-center gap-1 text-xs italic text-gray-400 dark:text-gray-500">
                                                    <span>•</span>
                                                    <span>@FormatDisplayDate(transaction.Date)</span>
                                                    @if (transaction.IsTransfer)
                                                    {
                                                        <span class="badge-blue hidden lg:block">Transfer</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="font-semibold @TransactionAmountClass(transaction.Type)">@SignedAmount(transaction.Amount, transaction.Type)</div>
                                    </div>
                                </div>
                            }
                        </div>
                        <Pagination CurrentPage="_transactionsPage" TotalItems="_transactionsTotal" PageSize="_transactionsPageSize" OnPageChanged="ChangeTransactionsPage" />
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Wallet Form Modal -->
@if (_showForm)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseWalletForm"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">@(_editingWallet is null ? "Add Wallet" : "Edit Wallet")</h2>
            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="mb-3 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-3 py-2 text-sm text-red-700 dark:text-red-400">@_formError</div>
            }
            <div class="space-y-4">
                <div>
                    <label class="form-label">Name *</label>
                    <input @bind="_walletName" class="form-input" placeholder="e.g. Main Account" />
                </div>
                <div>
                    <label class="form-label">Opening Balance</label>
                    <input @bind="_walletInitialBalance" class="form-input" type="number" step="0.01" disabled="@(_editingWallet is not null)" />
                    @if (_editingWallet is not null)
                    {
                        <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">Opening balance can only be set when the wallet is created.</div>
                    }
                </div>
                <div>
                    <label class="form-label">Currency *</label>
                    <input @bind="_walletCurrency" class="form-input" placeholder="USD" disabled="@(_editingWallet is not null)" />
                    @if (_editingWallet is not null)
                    {
                        <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">Currency can be changed in wallet settings.</div>
                    }
                </div>
                <div>
                    <label class="form-label">Icon</label>
                    <IconPicker @bind-Value="_walletIcon" Group="Wallet" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-5">
                <button class="btn-secondary" @onclick="CloseWalletForm">Cancel</button>
                <button class="btn-primary" @onclick="SaveWalletAsync" disabled="@_savingWallet">@(_savingWallet ? "Saving…" : "Save")</button>
            </div>
        </div>
    </div>
}

<!-- Transaction Form Modal -->
@if (_showTransactionForm)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseTransactionForm"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md mx-4 p-4 md:p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">@(_editingTransaction is null ? "Add Transaction" : "Edit Transaction")</h2>
            @if (!string.IsNullOrEmpty(_transactionFormError))
            {
                <div class="mb-3 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-3 py-2 text-sm text-red-700 dark:text-red-400">@_transactionFormError</div>
            }
            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="form-label">Amount *</label>
                        <CurrencyInput @bind-Value="_transactionAmount" Class="form-input" />
                    </div>
                    <div>
                        <label class="form-label">Date *</label>
                        <input @bind="_transactionDate" class="form-input" type="date" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="form-label">Type</label>
                        <SelectInput @bind-Value="_transactionType" @bind-Value:after="OnTransactionTypeAfterChange" Options="TransactionTypeOptions" />
                    </div>
                    <div>
                        <label class="form-label">Category *</label>
                        <SelectInput @bind-Value="_transactionCategoryId" Options="TransactionCategoryOptions" />
                    </div>
                </div>
                <div>
                    <label class="form-label">Note</label>
                    <textarea @bind="_transactionNote" class="form-input" rows="2" placeholder="Optional description"></textarea>
                </div>
                <div>
                    <label class="form-label">Wallet</label>
                    <SelectInput @bind-Value="_transactionWalletId" Options="TransactionWalletOptions" />
                </div>
            </div>
            <div class="flex justify-between gap-3 mt-5">
                @if (_editingTransaction is not null)
                {
                    <button class="btn-danger" @onclick="ConfirmDeleteTransaction(_editingTransaction)">Delete</button>
                }
                <div class="flex justify-end gap-3 ml-auto">
                    <button class="btn-secondary" @onclick="CloseTransactionForm">Cancel</button>
                    <button class="btn-primary" @onclick="SaveTransactionAsync" disabled="@_savingTransaction">@(_savingTransaction ? "Saving…" : "Save")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Transfer Form Modal -->
@if (_showTransferForm)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseTransferForm"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Transfer Funds</h2>
            @if (!string.IsNullOrEmpty(_transferFormError))
            {
                <div class="mb-3 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-3 py-2 text-sm text-red-700 dark:text-red-400">@_transferFormError</div>
            }
            <div class="space-y-4">
                <div>
                    <label class="form-label">From Wallet *</label>
                    <SelectInput @bind-Value="_transferFromWalletId" @bind-Value:after="OnTransferFromWalletChanged" Options="TransferFromWalletOptions" />
                </div>
                <div>
                    <label class="form-label">To Wallet *</label>
                    <SelectInput @bind-Value="_transferToWalletId" Options="TransferWalletOptions" />
                </div>
                <div>
                    <label class="form-label">Amount *</label>
                    <CurrencyInput @bind-Value="_transferAmount" Class="form-input" />
                </div>
                <div>
                    <label class="form-label">Date *</label>
                    <input @bind="_transferDate" class="form-input" type="date" />
                </div>
                <div>
                    <label class="form-label">Note</label>
                    <input @bind="_transferNote" class="form-input" placeholder="Optional description" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-5">
                <button class="btn-secondary" @onclick="CloseTransferForm">Cancel</button>
                <button class="btn-primary" @onclick="SaveTransferAsync" disabled="@(_savingTransfer || TransferTargets.Count == 0)">@(_savingTransfer ? "Saving…" : "Save")</button>
            </div>
        </div>
    </div>
}

<!-- Custom Date Range Modal -->
@if (_showCustomDateRangeModal)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseCustomDateRangeModal"></div>
        <div class="relative w-full max-w-md mx-4 rounded-lg bg-white dark:bg-gray-800 p-4 md:p-6 shadow-xl">
            <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">Custom Date Range</h2>
            @if (!string.IsNullOrWhiteSpace(_customDateRangeError))
            {
                <div class="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-800 dark:bg-red-900/30 dark:text-red-400">@_customDateRangeError</div>
            }
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label class="form-label">From</label>
                    <InputDate @bind-Value="_customDateFrom" class="form-input" />
                </div>
                <div>
                    <label class="form-label">To</label>
                    <InputDate @bind-Value="_customDateTo" class="form-input" />
                </div>
            </div>
            <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button class="btn-secondary w-full sm:w-auto" @onclick="CloseCustomDateRangeModal">Cancel</button>
                <button class="btn-primary w-full sm:w-auto" @onclick="ApplyCustomDateRangeAsync">Apply</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="_showDeleteWallet" Title="Delete wallet" Message="@($"Delete '{_deletingWallet?.Name}'?")" OnConfirm="DeleteWalletAsync" OnCancel="CancelDeleteWallet" />
<ConfirmDialog IsVisible="_showDeleteTransaction" Title="Delete transaction" Message="@($"Delete '{_deletingTransaction?.Note ?? _deletingTransaction?.CategoryName ?? "this transaction"}'?")" OnConfirm="DeleteTransactionAsync" OnCancel="CancelDeleteTransaction" />

@code {
    private static readonly string[] PieColors = ["#6366f1", "#8b5cf6", "#ec4899", "#f43f5e", "#f97316", "#eab308", "#22c55e", "#06b6d4", "#3b82f6", "#a855f7"];
    private const string DateRangeThisMonth = "this-month";
    private const string DateRangeLastMonth = "last-month";
    private const string DateRangeLastThreeMonths = "last-3-months";
    private const string DateRangeThisYear = "this-year";
    private const string DateRangeAll = "all";
    private const string DateRangeCustom = "custom";

    private List<WalletResponse> _wallets = [];
    private decimal _totalBalance;
    private bool _loading = true;
    private string? _error;

    // Selected wallets (empty = all wallets)
    private HashSet<Guid> _selectedWalletIds = [];
    private WalletResponse? _selectedWallet => _selectedWalletIds.Count == 1 ? _wallets.FirstOrDefault(w => w.Id == _selectedWalletIds.First()) : null;

    // Wallet form
    private bool _showForm;
    private WalletResponse? _editingWallet;
    private string _walletName = string.Empty;
    private decimal _walletInitialBalance;
    private string _walletCurrency = "VND";
    private string _walletIcon = string.Empty;
    private string? _formError;
    private bool _savingWallet;

    // Delete wallet
    private bool _showDeleteWallet;
    private WalletResponse? _deletingWallet;

    // Transaction list
    private List<CategoryResponse> _categories = [];
    private List<TransactionResponse> _transactions = [];
    private bool _loadingTransactions;
    private int _transactionsPage = 1;
    private int _transactionsTotal;
    private const int _transactionsPageSize = 20;
    private const string IncomeType = "Income";
    private const string ExpenseType = "Expense";
    private HashSet<string> _typeFilters = [];
    private HashSet<string> _dateRangeFilters = [DateRangeThisYear];
    private HashSet<string> _lastAppliedDateRangeFilters = [DateRangeThisYear];
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private HashSet<string> _categoryFilterIds = [];
    private bool _showCustomDateRangeModal;
    private DateOnly? _customDateFrom;
    private DateOnly? _customDateTo;
    private string? _customDateRangeError;

    // Transaction monthly summary (for selected wallet only)
    private GetTransactionSummaryResponse? _summary;

    // Transaction form
    private bool _showTransactionForm;
    private TransactionResponse? _editingTransaction;
    private decimal _transactionAmount;
    private string _transactionType = "Expense";
    private DateOnly _transactionDate = DateOnly.FromDateTime(DateTime.Today);
    private string _transactionNote = string.Empty;
    private string _transactionCategoryId = string.Empty;
    private string _transactionWalletId = string.Empty;
    private string? _transactionFormError;
    private bool _savingTransaction;

    // Transfer form
    private bool _showTransferForm;
    private string _transferFromWalletId = string.Empty;
    private string _transferToWalletId = string.Empty;
    private decimal _transferAmount;
    private DateOnly _transferDate = DateOnly.FromDateTime(DateTime.Today);
    private string _transferNote = string.Empty;
    private string? _transferFormError;
    private bool _savingTransfer;

    // Delete transaction
    private bool _showDeleteTransaction;
    private TransactionResponse? _deletingTransaction;

    // Bar chart data: date -> total expense amount
    private Dictionary<string, decimal> _barChartData = [];

    // A single selected type filters server-side; selecting both (or none) drops the filter, but any type/category selection still hides transfers.
    private string? SelectedType => _typeFilters.Count == 1 ? _typeFilters.First() : null;
    private bool HasTypeOrCategoryFilter => _typeFilters.Count > 0 || _categoryFilterIds.Count > 0;
    private IEnumerable<Guid>? SelectedCategoryIds => _categoryFilterIds.Count == 0 ? null : _categoryFilterIds.Select(ParseGuid).OfType<Guid>().ToList();

    private List<CategoryResponse> FilteredTransactionCategories => _categories.Where(c => string.Equals(c.Type, _transactionType, StringComparison.OrdinalIgnoreCase)).ToList();
    private List<WalletResponse> TransferTargets => _wallets.Where(w => w.Id != ParseGuid(_transferFromWalletId)).ToList();

    private static readonly IReadOnlyList<SelectOption> TransactionTypeOptions = [new("Income", "🪴 Income"), new("Expense", "💸 Expense")];
    private static readonly IReadOnlyList<SelectOption> DateRangeOptions =
    [
        new(DateRangeThisMonth, "This month"),
        new(DateRangeLastMonth, "Last Month"),
        new(DateRangeLastThreeMonths, "Last 3 months"),
        new(DateRangeThisYear, "This Year"),
        new(DateRangeAll, "All"),
        new(DateRangeCustom, "Custom")
    ];
    private IReadOnlyList<SelectOption> CategoryFilterOptions => _categories.Select(c => new SelectOption(c.Id.ToString(), c.Name, c.Icon)).ToList();
    private IReadOnlyList<SelectOption> TransactionCategoryOptions => FilteredTransactionCategories.Select(c => new SelectOption(c.Id.ToString(), c.Name, c.Icon)).Prepend(new SelectOption("", "Select category")).ToList();
    private IReadOnlyList<SelectOption> TransferFromWalletOptions => _wallets.Where(w => w.Id != ParseGuid(_transferToWalletId)).Select(w => new SelectOption(w.Id.ToString(), $"{w.Name} ({w.Currency})", w.Icon)).Prepend(new SelectOption("", "Select wallet")).ToList();
    private IReadOnlyList<SelectOption> TransferWalletOptions => TransferTargets.Select(w => new SelectOption(w.Id.ToString(), $"{w.Name} ({w.Currency})", w.Icon)).Prepend(new SelectOption("", "Select wallet")).ToList();
    private IReadOnlyList<SelectOption> TransactionWalletOptions => _wallets.Select(w => new SelectOption(w.Id.ToString(), $"{w.Name} ({w.Currency})", w.Icon)).ToList();

    protected override async Task OnInitializedAsync()
    {
        ResetDateRangeToDefault();
        await Task.WhenAll(LoadWalletsAsync(), LoadCategoriesAsync());
        await Task.WhenAll(LoadTransactionsAsync(), LoadBarChartAsync(), LoadSummaryAsync());
    }

    private async Task LoadWalletsAsync()
    {
        _loading = true;
        _error = null;
        var (data, error) = await Api.GetWalletsAsync();
        if (error is not null)
        {
            _wallets = [];
            _totalBalance = 0;
            _error = error.Message ?? "Failed to load wallets.";
        }
        else
        {
            _wallets = data?.Wallets ?? [];
            _totalBalance = data?.TotalBalance ?? 0;
        }
        _loading = false;
    }

    private async Task LoadCategoriesAsync()
    {
        var (data, _) = await Api.GetCategoriesAsync();
        _categories = data ?? [];
    }

    private async Task LoadTransactionsAsync()
    {
        _loadingTransactions = true;
        var walletIds = _selectedWalletIds.Count > 0 ? (IEnumerable<Guid>?)_selectedWalletIds : null;
        var (data, error) = await Api.GetTransactionsAsync(_transactionsPage, _transactionsPageSize, walletIds, SelectedType, FormatDateFilter(_dateFrom), FormatDateFilter(_dateTo), SelectedCategoryIds, HasTypeOrCategoryFilter);
        if (error is not null)
        {
            _transactions = [];
            _transactionsTotal = 0;
            _error = error.Message ?? "Failed to load transactions.";
        }
        else
        {
            _transactions = data?.Items ?? [];
            _transactionsTotal = data?.Total ?? 0;
        }
        _loadingTransactions = false;
    }

    private async Task LoadSummaryAsync()
    {
        if (_selectedWalletIds.Count > 1)
        {
            _summary = null;
            return;
        }
        var (start, end) = CurrentMonthRange();
        var (data, _) = await Api.GetTransactionSummaryAsync(_selectedWalletIds.Count == 1 ? _selectedWalletIds.First() : null, start, end);
        _summary = data;
    }

    private async Task LoadBarChartAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var from = today.AddDays(-29).ToString("yyyy-MM-dd");
        var to = today.ToString("yyyy-MM-dd");
        var (data, _) = await Api.GetTransactionsAsync(1, 500, null, ExpenseType, from, to);
        var items = data?.Items ?? [];
        _barChartData = items
            .GroupBy(t => t.Date)
            .ToDictionary(g => g.Key, g => g.Sum(t => t.Amount));
    }

    private async Task ChangeTransactionsPage(int page)
    {
        _transactionsPage = page;
        await LoadTransactionsAsync();
    }

    private Func<Task> SelectWallet(Guid id) => async () =>
    {
        if (!_selectedWalletIds.Remove(id))
            _selectedWalletIds.Add(id);
        _transactionsPage = 1;
        _typeFilters.Clear();
        ResetDateRangeToDefault();
        _categoryFilterIds.Clear();
        await Task.WhenAll(LoadTransactionsAsync(), LoadSummaryAsync());
    };

    private async Task SelectAllWallets()
    {
        _selectedWalletIds.Clear();
        _transactionsPage = 1;
        _typeFilters.Clear();
        ResetDateRangeToDefault();
        _categoryFilterIds.Clear();
        _summary = null;
        await LoadTransactionsAsync();
    }

    private Func<Task> ToggleTypeFilter(string type) => async () =>
    {
        if (!_typeFilters.Remove(type)) _typeFilters.Add(type);
        await ApplyFiltersAsync();
    };

    private async Task ApplyFiltersAsync()
    {
        _transactionsPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnDateRangeFilterChangedAsync()
    {
        if (_dateRangeFilters.Contains(DateRangeCustom) && !_lastAppliedDateRangeFilters.Contains(DateRangeCustom))
        {
            OpenCustomDateRangeModal();
            return;
        }

        _lastAppliedDateRangeFilters = [.._dateRangeFilters];
        ApplyDateRangeSelection();
        await ApplyFiltersAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _typeFilters.Clear();
        ResetDateRangeToDefault();
        _categoryFilterIds.Clear();
        _transactionsPage = 1;
        await LoadTransactionsAsync();
    }

    private void OpenCustomDateRangeModal()
    {
        _customDateRangeError = null;
        _customDateFrom = _dateFrom;
        _customDateTo = _dateTo;
        _showCustomDateRangeModal = true;
    }

    private void CloseCustomDateRangeModal()
    {
        _customDateRangeError = null;
        _showCustomDateRangeModal = false;
        _dateRangeFilters = [.._lastAppliedDateRangeFilters];
    }

    private async Task ApplyCustomDateRangeAsync()
    {
        _customDateRangeError = null;
        if (_customDateFrom is not null && _customDateTo is not null && _customDateFrom > _customDateTo)
        {
            _customDateRangeError = "From date must be earlier than or equal to To date.";
            return;
        }

        _lastAppliedDateRangeFilters = [.._dateRangeFilters];
        ApplyDateRangeSelection();
        _showCustomDateRangeModal = false;
        await ApplyFiltersAsync();
    }

    // ── Wallet CRUD ──

    private void OpenCreateWallet()
    {
        _editingWallet = null;
        _walletName = string.Empty;
        _walletInitialBalance = 0;
        _walletCurrency = "VND";
        _walletIcon = string.Empty;
        _formError = null;
        _showForm = true;
    }

    private Action OpenEditWallet(WalletResponse wallet) => () =>
    {
        _editingWallet = wallet;
        _walletName = wallet.Name;
        _walletInitialBalance = wallet.InitialBalance;
        _walletCurrency = wallet.Currency;
        _walletIcon = wallet.Icon ?? string.Empty;
        _formError = null;
        _showForm = true;
    };

    private void CloseWalletForm() => _showForm = false;

    private async Task SaveWalletAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_walletName)) { _formError = "Name is required."; return; }
        if (_editingWallet is null && string.IsNullOrWhiteSpace(_walletCurrency)) { _formError = "Currency is required."; return; }

        _savingWallet = true;
        var error = _editingWallet is null
            ? await Api.CreateWalletAsync(_walletName.Trim(), _walletInitialBalance, _walletCurrency.Trim(), CleanOptional(_walletIcon))
            : await Api.UpdateWalletAsync(_editingWallet.Id, _walletName.Trim(), CleanOptional(_walletIcon));

        if (error is not null) { _formError = error.Message ?? "Failed to save wallet."; _savingWallet = false; return; }

        _showForm = false;
        _savingWallet = false;
        await LoadWalletsAsync();
    }

    private Action ConfirmDeleteWallet(WalletResponse wallet) => () =>
    {
        _deletingWallet = wallet;
        _showDeleteWallet = true;
    };

    private void CancelDeleteWallet() { _showDeleteWallet = false; _deletingWallet = null; }

    private async Task DeleteWalletAsync()
    {
        if (_deletingWallet is null) return;
        _showDeleteWallet = false;
        var error = await Api.DeleteWalletAsync(_deletingWallet.Id);
        if (error is not null)
            _error = error.Message ?? "Failed to delete wallet.";
        else
        {
            _selectedWalletIds.Remove(_deletingWallet.Id);
            await LoadWalletsAsync();
            await LoadTransactionsAsync();
        }
        _deletingWallet = null;
    }

    // ── Transaction CRUD ──

    private void OpenCreateTransaction()
    {
        _editingTransaction = null;
        _transactionAmount = 0;
        _transactionType = "Expense";
        _transactionDate = DateOnly.FromDateTime(DateTime.Today);
        _transactionNote = string.Empty;
        _transactionCategoryId = string.Empty;
        _transactionFormError = null;
        _showTransactionForm = true;
        _transactionWalletId = _selectedWallet is not null ? _selectedWallet.Id.ToString() : _wallets.FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private Action RowClick(TransactionResponse transaction) => transaction.IsTransfer ? () => { } : OpenEditTransaction(transaction);

    private Action OpenEditTransaction(TransactionResponse transaction) => () =>
    {
        _editingTransaction = transaction;
        _transactionAmount = transaction.Amount;
        _transactionType = transaction.Type;
        _transactionDate = ParseDate(transaction.Date);
        _transactionNote = transaction.Note ?? string.Empty;
        _transactionCategoryId = transaction.CategoryId?.ToString() ?? string.Empty;
        _transactionWalletId = transaction.WalletId.ToString();
        _transactionFormError = null;
        _showTransactionForm = true;
    };

    private void CloseTransactionForm() => _showTransactionForm = false;

    private void OnTransactionTypeAfterChange()
    {
        var selected = FilteredTransactionCategories.FirstOrDefault(c => c.Id == ParseGuid(_transactionCategoryId));
        if (selected is null) _transactionCategoryId = string.Empty;
    }

    private async Task SaveTransactionAsync()
    {
        _transactionFormError = null;
        if (_transactionAmount <= 0) { _transactionFormError = "Amount must be greater than zero."; return; }
        if (ParseGuid(_transactionCategoryId) is not Guid categoryId) { _transactionFormError = "Category is required."; return; }

        if (ParseGuid(_transactionWalletId) is not Guid walletId) { _transactionFormError = "Wallet is required."; return; }

        _savingTransaction = true;
        var error = _editingTransaction is null
            ? await Api.CreateTransactionAsync(walletId, _transactionAmount, _transactionType, _transactionDate.ToString("yyyy-MM-dd"), CleanOptional(_transactionNote), categoryId)
            : await Api.UpdateTransactionAsync(_editingTransaction.Id, _transactionAmount, _transactionType, _transactionDate.ToString("yyyy-MM-dd"), CleanOptional(_transactionNote), categoryId, walletId);

        if (error is not null) { _transactionFormError = error.Message ?? "Failed to save transaction."; _savingTransaction = false; return; }

        _transactionsPage = 1;
        _showTransactionForm = false;
        _savingTransaction = false;
        await Task.WhenAll(LoadWalletsAsync(), LoadTransactionsAsync(), LoadSummaryAsync(), LoadBarChartAsync());
    }

    private void OpenCreateTransfer()
    {
        _transferFromWalletId = _selectedWallet?.Id.ToString() ?? string.Empty;
        _transferToWalletId = string.Empty;
        _transferAmount = 0;
        _transferDate = DateOnly.FromDateTime(DateTime.Today);
        _transferNote = string.Empty;
        _transferFormError = null;
        _showTransferForm = true;
    }

    private void CloseTransferForm() => _showTransferForm = false;

    private void OnTransferFromWalletChanged()
    {
        if (_transferFromWalletId == _transferToWalletId) _transferToWalletId = string.Empty;
    }

    private async Task SaveTransferAsync()
    {
        _transferFormError = null;
        if (ParseGuid(_transferFromWalletId) is not Guid fromWalletId) { _transferFormError = "Select a source wallet."; return; }
        if (ParseGuid(_transferToWalletId) is not Guid toWalletId) { _transferFormError = "Select a destination wallet."; return; }
        if (_transferAmount <= 0) { _transferFormError = "Amount must be greater than zero."; return; }

        _savingTransfer = true;
        var error = await Api.CreateTransferAsync(fromWalletId, toWalletId, _transferAmount, _transferDate.ToString("yyyy-MM-dd"), CleanOptional(_transferNote));
        if (error is not null) { _transferFormError = error.Message ?? "Failed to create transfer."; _savingTransfer = false; return; }

        _transactionsPage = 1;
        _showTransferForm = false;
        _savingTransfer = false;
        await Task.WhenAll(LoadWalletsAsync(), LoadTransactionsAsync(), LoadSummaryAsync());
    }

    private Action ConfirmDeleteTransaction(TransactionResponse transaction) => () =>
    {
        _deletingTransaction = transaction;
        _showDeleteTransaction = true;
        _showTransactionForm = false;
    };

    private void CancelDeleteTransaction() { _showDeleteTransaction = false; _deletingTransaction = null; }

    private async Task DeleteTransactionAsync()
    {
        if (_deletingTransaction is null) return;
        _showDeleteTransaction = false;
        var error = await Api.DeleteTransactionAsync(_deletingTransaction.Id);
        if (error is not null)
            _error = error.Message ?? "Failed to delete transaction.";
        else
            await Task.WhenAll(LoadWalletsAsync(), LoadTransactionsAsync(), LoadSummaryAsync(), LoadBarChartAsync());
        _deletingTransaction = null;
    }

    // ── Chart helpers ──

    private record PieSlice(string Name, double Fraction, string Color);

    private List<PieSlice> BuildPieData()
    {
        var wallets = _selectedWalletIds.Count > 0
            ? _wallets.Where(w => _selectedWalletIds.Contains(w.Id)).ToList()
            : _wallets;
        if (wallets.Count == 0) return [];
        var positiveTotal = wallets.Sum(w => Math.Max(0m, w.Balance));
        if (positiveTotal <= 0)
            return wallets.Select((w, i) => new PieSlice(w.Name, 1.0 / wallets.Count, PieColors[i % PieColors.Length])).ToList();
        return wallets
            .Select((w, i) => new PieSlice(w.Name, (double)(Math.Max(0m, w.Balance) / positiveTotal), PieColors[i % PieColors.Length]))
            .Where(s => s.Fraction > 0)
            .ToList();
    }

    // ── Formatting helpers ──

    private static string FormatAmount(decimal amount) => amount.ToString("N0");
    private static string SignedAmount(decimal amount, string type) => string.Equals(type, "Income", StringComparison.OrdinalIgnoreCase) ? $"+{amount:N0}" : $"-{amount:N0}";
    private static string TransactionAmountClass(string type) => string.Equals(type, "Income", StringComparison.OrdinalIgnoreCase) ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400";
    private static string FormatDisplayDate(string value) => DateOnly.TryParse(value, out var date) ? date.ToString("dd MMM") : value;
    private static string? FormatDateFilter(DateOnly? value) => value?.ToString("yyyy-MM-dd");
    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var parsed) ? parsed : null;
    private static string? CleanOptional(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static DateOnly ParseDate(string value) => DateOnly.TryParse(value, out var date) ? date : DateOnly.FromDateTime(DateTime.Today);
    private string TypeFilterClass(string type) => (string.IsNullOrEmpty(type) ? _typeFilters.Count == 0 : _typeFilters.Contains(type)) ? "btn-primary btn-sm" : "btn-secondary btn-sm";

    private string TransactionIcon(TransactionResponse transaction)
    {
        var category = _categories.FirstOrDefault(c => c.Id == transaction.CategoryId);
        if (!string.IsNullOrWhiteSpace(category?.Icon)) return category.Icon!;
        if (transaction.IsTransfer) return "🔁";
        return string.Equals(transaction.Type, "Income", StringComparison.OrdinalIgnoreCase) ? "💰" : "💸";
    }

    private static string TransactionTitle(TransactionResponse transaction) => string.IsNullOrWhiteSpace(transaction.Note) ? "No description" : transaction.Note;
    private static string TransactionCategoryLabel(TransactionResponse transaction) => transaction.IsTransfer ? "Transfer" : string.IsNullOrWhiteSpace(transaction.CategoryName) ? "Uncategorized" : transaction.CategoryName!;

    private static (string start, string end) CurrentMonthRange()
    {
        var (start, end) = ResolveDateRange(DateRangeThisMonth);
        return (start!.Value.ToString("yyyy-MM-dd"), end!.Value.ToString("yyyy-MM-dd"));
    }

    private void ResetDateRangeToDefault()
    {
        _dateRangeFilters = [DateRangeThisYear];
        _lastAppliedDateRangeFilters = [DateRangeThisYear];
        _customDateFrom = null;
        _customDateTo = null;
        ApplyDateRangeSelection();
    }

    // Multiple selected ranges collapse into the single span that covers them all; an unbounded end stays unbounded.
    private void ApplyDateRangeSelection()
    {
        var ranges = _dateRangeFilters.Select(v => v == DateRangeCustom ? (_customDateFrom, _customDateTo) : ResolveDateRange(v)).ToList();
        _dateFrom = ranges.Count == 0 || ranges.Any(r => r.Item1 is null) ? null : ranges.Min(r => r.Item1);
        _dateTo = ranges.Count == 0 || ranges.Any(r => r.Item2 is null) ? null : ranges.Max(r => r.Item2);
    }

    private static (DateOnly? start, DateOnly? end) ResolveDateRange(string value)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var monthStart = new DateOnly(today.Year, today.Month, 1);

        return value switch
        {
            DateRangeThisMonth => (monthStart, monthStart.AddMonths(1).AddDays(-1)),
            DateRangeLastMonth => (monthStart.AddMonths(-1), monthStart.AddDays(-1)),
            DateRangeLastThreeMonths => (monthStart.AddMonths(-2), monthStart.AddMonths(1).AddDays(-1)),
            DateRangeThisYear => (new DateOnly(today.Year, 1, 1), new DateOnly(today.Year, 12, 31)),
            _ => (null, null)
        };
    }
}
