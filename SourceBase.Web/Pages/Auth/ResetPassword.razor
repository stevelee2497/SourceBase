@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject NavigationManager Navigation

<h2 class="text-xl font-semibold text-gray-900 mb-2">Reset your password</h2>
<p class="text-sm text-gray-500 mb-6">Enter the code from your email and choose a new password.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="space-y-4">
        <div>
            <label class="form-label">Email</label>
            <InputText @bind-Value="_model.Email" class="form-input" type="email" placeholder="you@example.com"
                       autocomplete="email" />
        </div>
        <div>
            <label class="form-label">Reset code</label>
            <InputText @bind-Value="_model.Code" class="form-input" placeholder="6-digit code from email"
                       autocomplete="one-time-code" />
        </div>
        <div>
            <label class="form-label">New password</label>
            <InputText @bind-Value="_model.NewPassword" class="form-input" type="password" placeholder="••••••••"
                       autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Confirm new password</label>
            <InputText @bind-Value="_model.ConfirmPassword" class="form-input" type="password" placeholder="••••••••"
                       autocomplete="new-password" />
            @if (!string.IsNullOrEmpty(_model.NewPassword) && _model.NewPassword != _model.ConfirmPassword)
            {
                <p class="form-error">Passwords do not match.</p>
            }
        </div>
    </div>

    <div class="mt-6">
        <button type="submit" class="btn-primary w-full"
                disabled="@(_loading || (_model.NewPassword != _model.ConfirmPassword))">
            @if (_loading)
            {
                <span>Resetting…</span>
            }
            else
            {

                <span>Reset password</span>
            }
        </button>
    </div>
</EditForm>

<div class="mt-4 text-center">
    <a href="/login" class="text-sm text-indigo-600 hover:text-indigo-500">← Back to sign in</a>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private readonly ResetFormModel _model = new();
    private string? _error;
    private bool _loading;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Email))
            _model.Email = Email;
    }

    private async Task SubmitAsync()
    {
        if (_model.NewPassword != _model.ConfirmPassword) return;

        _error = null;
        _loading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/resetPassword", new
            {
                email = _model.Email,
                code = _model.Code,
                newPassword = _model.NewPassword
            });
            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo("/login?reset=1");
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 401)
        {
            _error = "Invalid or expired reset code. Please request a new one.";
        }
        catch
        {
            _error = "Password reset failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ResetFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
