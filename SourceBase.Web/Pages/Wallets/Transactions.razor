@page "/wallets/transactions"
@attribute [Authorize]
@inject ApiHttpClient Api

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<div class="card mb-6">
    <div class="flex flex-col gap-4">
        <div>
            <div class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-2">Type</div>
            <div class="flex flex-wrap gap-2">
                <button class="@TypeFilterClass(string.Empty)" @onclick="SelectAllTypes">All</button>
                <button class="@TypeFilterClass(IncomeType)" @onclick="SelectIncomeType">Income</button>
                <button class="@TypeFilterClass(ExpenseType)" @onclick="SelectExpenseType">Expense</button>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="form-label">Wallet</label>
                <SelectInput @bind-Value="_walletFilterId" Options="WalletFilterOptions" />
            </div>
            <div>
                <label class="form-label">Date From</label>
                <InputDate @bind-Value="_dateFrom" class="form-input" />
            </div>
            <div>
                <label class="form-label">Date To</label>
                <InputDate @bind-Value="_dateTo" class="form-input" />
            </div>
            <div>
                <label class="form-label">Category</label>
                <SelectInput @bind-Value="_categoryFilterId" Options="CategoryFilterOptions" />
            </div>
        </div>
        <div class="flex flex-col sm:flex-row sm:justify-end gap-3">
            <button class="btn-secondary" @onclick="ResetFiltersAsync">Clear</button>
            <button class="btn-primary" @onclick="ApplyFiltersAsync">Apply Filters</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="flex items-center justify-between gap-3 mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Transactions</h2>
        <div class="text-sm text-gray-500">@_total item(s)</div>
    </div>

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_transactions.Count == 0)
    {
        <div class="text-sm text-gray-400 py-8 text-center">No transactions found.</div>
    }
    else
    {
        <div class="flex flex-col divide-y divide-gray-100">
            @foreach (var transaction in _transactions)
            {
                <div class="py-4 flex flex-col sm:flex-row sm:items-center gap-3">
                    <div class="flex items-start gap-3 flex-1 min-w-0">
                        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-lg shrink-0">@TransactionIcon(transaction)</div>
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-gray-900 truncate">@TransactionCategoryLabel(transaction)</div>
                            <div class="text-sm text-gray-500 truncate">@TransactionTitle(transaction)</div>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-400">
                                <span>@FormatDisplayDate(transaction.Date)</span>
                                <span>•</span>
                                <span>@transaction.WalletName</span>
                                @if (transaction.IsTransfer)
                                {
                                    <span class="badge-blue">Transfer</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between sm:justify-end gap-3 sm:gap-4">
                        <div class="font-semibold @TransactionAmountClass(transaction.Type)">@SignedAmount(transaction.Amount, transaction.Type)</div>
                        @if (!transaction.IsTransfer)
                        {
                            <div class="flex items-center gap-2">
                                <button class="text-gray-400 hover:text-indigo-600 transition-colors" @onclick="OpenEditTransaction(transaction)" title="Edit transaction">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button class="text-gray-400 hover:text-red-600 transition-colors" @onclick="ConfirmDeleteTransaction(transaction)" title="Delete transaction">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <Pagination CurrentPage="_page" TotalItems="_total" PageSize="_pageSize" OnPageChanged="ChangePageAsync" />
    }
</div>

@if (_showForm)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseForm"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Edit Transaction</h2>
            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="mb-3 rounded-md bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700">@_formError</div>
            }
            <div class="space-y-4">
                <div>
                    <label class="form-label">Amount *</label>
                    <CurrencyInput @bind-Value="_amount" Class="form-input" />
                </div>
                <div>
                    <label class="form-label">Type</label>
                    <SelectInput @bind-Value="_type" @bind-Value:after="OnTypeAfterChange" Options="TransactionTypeOptions" />
                </div>
                <div>
                    <label class="form-label">Date *</label>
                    <input @bind="_date" class="form-input" type="date" />
                </div>
                <div>
                    <label class="form-label">Note</label>
                    <input @bind="_note" class="form-input" placeholder="Optional description" />
                </div>
                <div>
                    <label class="form-label">Category *</label>
                    <SelectInput @bind-Value="_categoryId" Options="EditCategoryOptions" />
                </div>
                <div>
                    <label class="form-label">Wallet *</label>
                    <SelectInput @bind-Value="_walletId" Options="EditWalletOptions" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-5">
                <button class="btn-secondary" @onclick="CloseForm">Cancel</button>
                <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="_showDelete" Title="Delete transaction" Message="@($"Delete '{_deleting?.Note ?? _deleting?.CategoryName ?? "this transaction"}'?")" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code {
    private List<WalletResponse> _wallets = [];
    private List<CategoryResponse> _categories = [];
    private List<TransactionResponse> _transactions = [];

    private bool _loading = true;
    private string? _error;

    private const string IncomeType = "Income";
    private const string ExpenseType = "Expense";

    private int _page = 1;
    private int _total;
    private const int _pageSize = 20;

    private string _typeFilter = string.Empty;
    private string _walletFilterId = string.Empty;
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private string _categoryFilterId = string.Empty;

    private bool _showForm;
    private TransactionResponse? _editing;
    private decimal _amount;
    private string _type = "Expense";
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today);
    private string _note = string.Empty;
    private string _categoryId = string.Empty;
    private string _walletId = string.Empty;
    private string? _formError;
    private bool _saving;

    private bool _showDelete;
    private TransactionResponse? _deleting;

    private List<CategoryResponse> FilteredCategories => _categories.Where(c => string.Equals(c.Type, _type, StringComparison.OrdinalIgnoreCase)).ToList();

    private static readonly IReadOnlyList<SelectOption> TransactionTypeOptions = [new("Income", "Income"), new("Expense", "Expense")];
    private IReadOnlyList<SelectOption> WalletFilterOptions => _wallets.Select(w => new SelectOption(w.Id.ToString(), $"{WalletIcon(w.Icon)} {w.Name} ({w.Currency})")).Prepend(new SelectOption("", "All wallets")).ToList();
    private IReadOnlyList<SelectOption> CategoryFilterOptions => _categories.Select(c => new SelectOption(c.Id.ToString(), $"{CategoryIcon(c.Icon)} {c.Name} ({c.Type})")).Prepend(new SelectOption("", "All categories")).ToList();
    private IReadOnlyList<SelectOption> EditCategoryOptions => FilteredCategories.Select(c => new SelectOption(c.Id.ToString(), $"{CategoryIcon(c.Icon)} {c.Name}")).Prepend(new SelectOption("", "Select category")).ToList();
    private IReadOnlyList<SelectOption> EditWalletOptions => _wallets.Select(w => new SelectOption(w.Id.ToString(), $"{WalletIcon(w.Icon)} {w.Name} ({w.Currency})")).Prepend(new SelectOption("", "Select wallet")).ToList();

    protected override async Task OnInitializedAsync() => await Task.WhenAll(LoadWalletsAsync(), LoadCategoriesAsync(), LoadTransactionsAsync());

    private async Task LoadWalletsAsync()
    {
        var (data, error) = await Api.GetWalletsAsync();
        if (error is null) _wallets = data?.Wallets ?? [];
    }

    private async Task LoadCategoriesAsync()
    {
        var (data, error) = await Api.GetCategoriesAsync();
        if (error is null) _categories = data ?? [];
    }

    private async Task LoadTransactionsAsync()
    {
        _loading = true;
        var walletId = ParseGuid(_walletFilterId);
        var walletIds = walletId.HasValue ? new[] { walletId.Value } : null;
        var (data, error) = await Api.GetTransactionsAsync(_page, _pageSize, walletIds, EmptyToNull(_typeFilter), FormatDateFilter(_dateFrom), FormatDateFilter(_dateTo), ParseGuid(_categoryFilterId));
        if (error is not null)
        {
            _transactions = [];
            _total = 0;
            _error = error.Message ?? "Failed to load transactions.";
        }
        else
        {
            _transactions = data?.Items ?? [];
            _total = data?.Total ?? 0;
        }
        _loading = false;
    }

    private async Task ChangePageAsync(int page)
    {
        _error = null;
        _page = page;
        await LoadTransactionsAsync();
    }

    private Action SelectTypeFilter(string type) => () => _typeFilter = type;
    private Action SelectAllTypes => SelectTypeFilter(string.Empty);
    private Action SelectIncomeType => SelectTypeFilter(IncomeType);
    private Action SelectExpenseType => SelectTypeFilter(ExpenseType);

    private async Task ApplyFiltersAsync()
    {
        _error = null;
        _page = 1;
        await LoadTransactionsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _error = null;
        _typeFilter = string.Empty;
        _walletFilterId = string.Empty;
        _dateFrom = null;
        _dateTo = null;
        _categoryFilterId = string.Empty;
        _page = 1;
        await LoadTransactionsAsync();
    }

    private Action OpenEditTransaction(TransactionResponse transaction) => () =>
    {
        _editing = transaction;
        _amount = transaction.Amount;
        _type = transaction.Type;
        _date = ParseDate(transaction.Date);
        _note = transaction.Note ?? string.Empty;
        _categoryId = transaction.CategoryId?.ToString() ?? string.Empty;
        _walletId = transaction.WalletId.ToString();
        _formError = null;
        _showForm = true;
    };

    private void CloseForm() => _showForm = false;

    private void OnTypeAfterChange()
    {
        var selected = FilteredCategories.FirstOrDefault(c => c.Id == ParseGuid(_categoryId));
        if (selected is null) _categoryId = string.Empty;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        if (_amount <= 0) { _formError = "Amount must be greater than zero."; return; }
        if (ParseGuid(_categoryId) is not Guid categoryId) { _formError = "Category is required."; return; }
        if (ParseGuid(_walletId) is not Guid walletId) { _formError = "Wallet is required."; return; }

        _saving = true;
        var error = await Api.UpdateTransactionAsync(_editing!.Id, _amount, _type, _date.ToString("yyyy-MM-dd"), CleanOptional(_note), categoryId, walletId);
        if (error is not null)
        {
            _formError = error.Message ?? "Failed to save transaction.";
            _saving = false;
            return;
        }
        _showForm = false;
        _saving = false;
        await LoadTransactionsAsync();
    }

    private Action ConfirmDeleteTransaction(TransactionResponse transaction) => () =>
    {
        _deleting = transaction;
        _showDelete = true;
    };

    private void CancelDelete() { _showDelete = false; _deleting = null; }

    private async Task DeleteAsync()
    {
        if (_deleting is null) return;
        _showDelete = false;
        var error = await Api.DeleteTransactionAsync(_deleting.Id);
        if (error is not null)
            _error = error.Message ?? "Failed to delete transaction.";
        else
            await LoadTransactionsAsync();
        _deleting = null;
    }

    private string TransactionIcon(TransactionResponse transaction)
    {
        var category = _categories.FirstOrDefault(c => c.Id == transaction.CategoryId);
        if (!string.IsNullOrWhiteSpace(category?.Icon)) return category.Icon!;
        if (transaction.IsTransfer) return "🔁";
        return string.Equals(transaction.Type, "Income", StringComparison.OrdinalIgnoreCase) ? "💰" : "💸";
    }

    private static string TransactionTitle(TransactionResponse transaction) => string.IsNullOrWhiteSpace(transaction.Note) ? "No description" : transaction.Note;

    private static string TransactionCategoryLabel(TransactionResponse transaction) => transaction.IsTransfer ? "Transfer" : string.IsNullOrWhiteSpace(transaction.CategoryName) ? "Uncategorized" : transaction.CategoryName!;

    private static string TransactionAmountClass(string type) => string.Equals(type, "Income", StringComparison.OrdinalIgnoreCase) ? "text-green-600" : "text-red-600";

    private static string SignedAmount(decimal amount, string type) => string.Equals(type, "Income", StringComparison.OrdinalIgnoreCase) ? $"+{amount:N0}" : $"-{amount:N0}";

    private static string FormatDisplayDate(string value) => DateOnly.TryParse(value, out var date) ? date.ToString("dd MMM yyyy") : value;

    private static string WalletIcon(string? icon) => string.IsNullOrWhiteSpace(icon) ? "👛" : icon;

    private static string CategoryIcon(string? icon) => string.IsNullOrWhiteSpace(icon) ? "🏷️" : icon;

    private string TypeFilterClass(string type) => _typeFilter == type ? "btn-primary btn-sm" : "btn-secondary btn-sm";

    private static string? EmptyToNull(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private static string? FormatDateFilter(DateOnly? value) => value?.ToString("yyyy-MM-dd");

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var parsed) ? parsed : null;

    private static string? CleanOptional(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static DateOnly ParseDate(string value) => DateOnly.TryParse(value, out var date) ? date : DateOnly.FromDateTime(DateTime.Today);
}
