@rendermode InteractiveServer

@inject BlazorAuthStateProvider AuthStateProvider
@inject HttpClient Http

@if (_isReady)
{
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (!context.User.Identity?.IsAuthenticated ?? true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="flex items-center justify-center min-h-screen">
                            <div class="text-center">
                                <h1 class="text-2xl font-semibold text-gray-900 mb-2">Access Denied</h1>
                                <p class="text-gray-500">You don't have permission to view this page.</p>
                                <a href="/" class="mt-4 inline-block text-indigo-600 hover:text-indigo-500">Go home</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="flex items-center justify-center min-h-screen text-gray-400">Loading…</div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <div class="flex items-center justify-center min-h-screen">
                <div class="text-center">
                    <h1 class="text-4xl font-bold text-gray-900 mb-2">404</h1>
                    <p class="text-gray-500 mb-4">Page not found.</p>
                    <a href="/" class="text-indigo-600 hover:text-indigo-500">Go home</a>
                </div>
            </div>
        </NotFound>
    </Router>
}
else
{
    <div class="flex items-center justify-center min-h-screen text-gray-400">Loading…</div>
}

@code {
    private bool _isReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await InitializeAuthAsync();
        }
        finally
        {
            _isReady = true;
            StateHasChanged();
        }
    }

    private async Task InitializeAuthAsync()
    {
        var hasToken = await AuthStateProvider.LoadTokensAsync();
        if (!hasToken)
            return;

        try
        {
            var userInfo = await TryGetUserInfoAsync();
            if (userInfo is not null)
            {
                AuthStateProvider.SetUserInfo(userInfo);
                return;
            }

            if (string.IsNullOrWhiteSpace(AuthStateProvider.RefreshToken))
            {
                await AuthStateProvider.SignOutAsync();
                return;
            }

            var refreshResponse = await Http.PostAsJsonAsync("/api/auth/refresh", new { token = AuthStateProvider.RefreshToken });
            if (refreshResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await AuthStateProvider.SignOutAsync();
                return;
            }

            refreshResponse.EnsureSuccessStatusCode();

            var tokens = await refreshResponse.Content.ReadFromJsonAsync<LoginTokensResponse>()
                ?? throw new InvalidOperationException("Refresh response did not include tokens.");

            await AuthStateProvider.SetTokensAsync(tokens);

            userInfo = await TryGetUserInfoAsync();
            if (userInfo is null)
            {
                await AuthStateProvider.SignOutAsync();
                return;
            }

            AuthStateProvider.SetUserInfo(userInfo);
        }
        catch
        {
            await AuthStateProvider.SignOutAsync();
        }
    }

    private async Task<UserInfoResponse?> TryGetUserInfoAsync()
    {
        try
        {
            return await Http.GetFromJsonAsync<UserInfoResponse>("/api/auth/info");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            return null;
        }
    }
}
