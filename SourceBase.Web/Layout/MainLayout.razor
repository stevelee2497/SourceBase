@inject BlazorAuthStateProvider AuthStateProvider
@inject ApiHttpClient Api
@inject NavigationManager Navigation
@inherits LayoutComponentBase
@implements IDisposable

<div class="flex h-screen bg-gray-50">
    <NavMenu MobileOpen="_mobileMenuOpen" OnMobileClose="() => _mobileMenuOpen = false" />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <div class="flex items-center h-16 px-4 md:px-6 bg-white border-b border-gray-200 shrink-0 gap-3">
            <!-- Hamburger (mobile only) -->
            <button class="md:hidden p-1.5 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100"
                    @onclick="() => _mobileMenuOpen = true" aria-label="Open menu">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <div class="flex-1 text-lg font-semibold text-gray-800">
                @GetPageTitle()
            </div>
            <div class="flex items-center gap-2 md:gap-3 shrink-0">
                <AuthorizeView>
                    <Authorized>
                        <span class="hidden sm:inline text-sm text-gray-600 truncate max-w-[140px]">@context.User.Identity?.Name</span>
                        <button class="btn-secondary btn-sm" @onclick="LogoutAsync">Sign out</button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Main content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _mobileMenuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task LogoutAsync()
    {
        if (!string.IsNullOrWhiteSpace(AuthStateProvider.AccessToken))
            await Api.LogoutAsync();

        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetPageTitle()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimStart('/');
        return path switch
        {
            "" => "Dashboard",
            "todos" => "Todos",
            "users" => "User Management",
            "roles" => "Role Management",
            _ => "SourceBase"
        };
    }
}
