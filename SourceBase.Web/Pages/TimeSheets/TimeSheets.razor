@page "/time-sheets"
@attribute [Authorize]
@inject ApiHttpClient Api

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<div class="flex flex-col gap-6">

    <!-- Calendar header -->
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Time Sheets</h2>
        <div class="flex items-center gap-2">
            <button class="btn-secondary btn-sm" @onclick="PrevMonth">&#8249;</button>
            <span class="text-sm font-medium text-gray-700 min-w-[130px] text-center">@_currentDate.ToString("MMMM yyyy")</span>
            <button class="btn-secondary btn-sm" @onclick="NextMonth">&#8250;</button>
        </div>
    </div>

    @if (_loadingSummary)
    {
        <LoadingSpinner />
    }
    else
    {
        <!-- Calendar grid -->
        <div class="card p-4">
            <div class="grid grid-cols-7 gap-1 mb-1">
                @foreach (var dayName in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <div class="text-xs text-center font-medium text-gray-500 py-1">@dayName</div>
                }
            </div>
            <div class="grid grid-cols-7 gap-1">
                @foreach (var cell in _calendarCells)
                {
                    @if (cell is null)
                    {
                        <div class="h-16 rounded"></div>
                    }
                    else
                    {
                        var date = cell.Value;
                        var summary = _summaryByDate.GetValueOrDefault(date);
                        var isSelected = _selectedDate == date;
                        <button class="@GetCellClass(date, summary, isSelected)" @onclick="SelectDay(date)">
                            <span class="text-xs font-bold leading-none">@date.Day</span>
                            @if (summary is not null)
                            {
                                <span class="text-xs mt-0.5 font-medium leading-none">@summary.TotalHours h</span>
                                <span class="text-xs leading-none opacity-75 truncate w-full text-center px-0.5">@string.Join(", ", summary.Projects)</span>
                            }
                            @if (IsSos(date, summary))
                            {
                                <span class="text-xs font-bold leading-none">SOS</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    }

    <!-- Detail section -->
    @if (_selectedDate is not null)
    {
        <div class="card p-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-3">@_selectedDate.Value.ToString("dddd, MMMM d, yyyy")</h3>

            @if (_loadingDetail)
            {
                <LoadingSpinner />
            }
            else
            {
                @foreach (var entry in _dayEntries)
                {
                    @if (_editingId == entry.Id)
                    {
                        <div class="flex items-center gap-2 mb-2">
                            <input class="form-input flex-1" @bind="_editProject" placeholder="Project" />
                            <input class="form-input w-28" type="number" step="0.5" min="0.5" max="24" @bind="_editHours" />
                            <button class="btn-primary btn-sm" @onclick="SaveEdit">Save</button>
                            <button class="btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
                            <span class="flex-1 text-sm text-gray-800">@entry.Project</span>
                            <span class="text-sm font-medium text-gray-600">@entry.Hours h</span>
                            <button class="text-xs text-gray-400 hover:text-indigo-600 transition-colors" @onclick="OpenEdit(entry)">Edit</button>
                            <button class="text-xs text-gray-400 hover:text-red-600 transition-colors" @onclick="DeleteEntry(entry.Id)">Delete</button>
                        </div>
                    }
                }

                @if (_dayEntries.Count == 0 && !_showAddForm)
                {
                    <p class="text-sm text-gray-400 py-2">No entries for this day.</p>
                }

                @if (!_showAddForm)
                {
                    <button class="btn-primary btn-sm mt-3" @onclick="OpenAddForm">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Entry
                    </button>
                }
                else
                {
                    <div class="flex items-center gap-2 mt-3">
                        <input class="form-input flex-1" @bind="_newProject" placeholder="Project name" />
                        <input class="form-input w-28" type="number" step="0.5" min="0.5" max="24" @bind="_newHours" />
                        <button class="btn-primary btn-sm" @onclick="SaveNewEntry">Save</button>
                        <button class="btn-secondary btn-sm" @onclick="CloseAddForm">Cancel</button>
                    </div>
                }
            }
        </div>
    }

</div>

@code {
    private DateOnly _currentDate = DateOnly.FromDateTime(DateTime.Today).AddDays(1 - DateTime.Today.Day);
    private Dictionary<DateOnly, TimeSheetSummaryDayResponse> _summaryByDate = [];
    private List<DateOnly?> _calendarCells = [];
    private DateOnly? _selectedDate;
    private List<TimeSheetItemResponse> _dayEntries = [];
    private bool _loadingSummary;
    private bool _loadingDetail;
    private string? _error;

    private Guid? _editingId;
    private string _editProject = string.Empty;
    private decimal _editHours;

    private bool _showAddForm;
    private string _newProject = string.Empty;
    private decimal _newHours = 8;

    protected override async Task OnInitializedAsync() => await LoadSummaryAsync();

    private async Task LoadSummaryAsync()
    {
        _loadingSummary = true;
        _error = null;
        var (data, error) = await Api.GetTimeSheetSummaryAsync(_currentDate.Year, _currentDate.Month);
        if (error is not null)
            _error = error.Message;
        else
            _summaryByDate = (data?.Days ?? []).ToDictionary(x => x.Date);
        BuildCalendarCells();
        _loadingSummary = false;
    }

    private void BuildCalendarCells()
    {
        _calendarCells = [];
        var firstDay = _currentDate;
        var daysInMonth = DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month);

        // DayOfWeek: Sunday=0, Monday=1..Saturday=6 → convert to Mon=0..Sun=6
        var startOffset = ((int)firstDay.DayOfWeek + 6) % 7;
        for (var i = 0; i < startOffset; i++)
            _calendarCells.Add(null);
        for (var d = 1; d <= daysInMonth; d++)
            _calendarCells.Add(new DateOnly(_currentDate.Year, _currentDate.Month, d));
    }

    private Func<Task> SelectDay(DateOnly date) => async () =>
    {
        _selectedDate = date;
        _showAddForm = false;
        _editingId = null;
        await LoadDayDetailAsync();
    };

    private async Task LoadDayDetailAsync()
    {
        if (_selectedDate is null) return;
        _loadingDetail = true;
        var (data, error) = await Api.GetTimeSheetsAsync(_selectedDate.Value);
        if (error is not null)
            _error = error.Message;
        else
            _dayEntries = data?.Items ?? [];
        _loadingDetail = false;
    }

    private async Task PrevMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        _selectedDate = null;
        _dayEntries = [];
        await LoadSummaryAsync();
    }

    private async Task NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        _selectedDate = null;
        _dayEntries = [];
        await LoadSummaryAsync();
    }

    private Action OpenEdit(TimeSheetItemResponse entry) => () =>
    {
        _editingId = entry.Id;
        _editProject = entry.Project;
        _editHours = entry.Hours;
        _showAddForm = false;
    };

    private void CancelEdit()
    {
        _editingId = null;
        _editProject = string.Empty;
        _editHours = 0;
    }

    private async Task SaveEdit()
    {
        if (_editingId is null || _selectedDate is null) return;
        var (_, error) = await Api.UpsertTimeSheetsAsync([new TimeSheetUpsertItem(_selectedDate.Value.ToString("yyyy-MM-dd"), _editProject, _editHours)]);
        if (error is not null) { _error = error.Message; return; }
        _editingId = null;
        await RefreshAsync();
    }

    private Func<Task> DeleteEntry(Guid id) => async () =>
    {
        var error = await Api.DeleteTimeSheetAsync(id);
        if (error is not null) { _error = error.Message; return; }
        await RefreshAsync();
    };

    private void OpenAddForm()
    {
        _showAddForm = true;
        _newProject = string.Empty;
        _newHours = 8;
        _editingId = null;
    }

    private void CloseAddForm()
    {
        _showAddForm = false;
        _newProject = string.Empty;
        _newHours = 8;
    }

    private async Task SaveNewEntry()
    {
        if (_selectedDate is null || string.IsNullOrWhiteSpace(_newProject)) return;
        var (_, error) = await Api.UpsertTimeSheetsAsync([new TimeSheetUpsertItem(_selectedDate.Value.ToString("yyyy-MM-dd"), _newProject, _newHours)]);
        if (error is not null) { _error = error.Message; return; }
        CloseAddForm();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadDayDetailAsync();
        var (data, _) = await Api.GetTimeSheetSummaryAsync(_currentDate.Year, _currentDate.Month);
        _summaryByDate = (data?.Days ?? []).ToDictionary(x => x.Date);
        StateHasChanged();
    }

    private static bool IsSos(DateOnly date, TimeSheetSummaryDayResponse? summary)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var isWeekday = date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday;
        return summary is null && isWeekday && date <= today;
    }

    private string GetCellClass(DateOnly date, TimeSheetSummaryDayResponse? summary, bool isSelected)
    {
        var ring = isSelected ? " ring-2 ring-indigo-500 ring-offset-1" : string.Empty;
        if (summary is not null)
            return $"h-16 rounded border flex flex-col items-center justify-center p-1 overflow-hidden transition-all cursor-pointer bg-green-50 border-green-200 text-green-800 hover:bg-green-100{ring}";
        if (IsSos(date, summary))
            return $"h-16 rounded border flex flex-col items-center justify-center p-1 transition-all cursor-pointer bg-red-50 border-red-200 text-red-700 hover:bg-red-100{ring}";
        return $"h-16 rounded border flex flex-col items-center justify-center p-1 transition-all cursor-pointer bg-gray-50 border-gray-200 text-gray-500 hover:bg-gray-100{ring}";
    }
}
