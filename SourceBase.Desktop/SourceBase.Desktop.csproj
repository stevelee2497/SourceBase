<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<RootNamespace>SourceBase.Desktop</RootNamespace>
		<AssemblyName>Jupiter</AssemblyName>
		<Product>Jupiter</Product>
		<Version>0.0</Version>
		<ApplicationIcon>Assets\jupiter.ico</ApplicationIcon>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!-- publish defaults: dotnet publish -c Release -->
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishDir>artifacts\</PublishDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- Modern WPF tray-icon library (NOTIFYICON). Hardcodet.NotifyIcon.Wpf is the classic
		alternative. -->
		<PackageReference Include="H.NotifyIcon.Wpf" />
	</ItemGroup>

	<!-- Copy a local .env (if present) next to the exe so Config.DotEnv finds it. Git-ignored;
	     never present in CI, so published builds ship no .env. -->
	<ItemGroup>
		<None Include=".env" Condition="Exists('.env')" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Default ApiBaseUrl is injected at build time from the API_URL env var
	     (set by the GitHub repo variable in desktop-publish.yml) — never hardcoded in source.
	     Empty when unset (local dev) → ApiBaseUrl stays null and API sync no-ops. -->
	<PropertyGroup>
		<JupiterApiBaseUrl>$(API_URL)</JupiterApiBaseUrl>
	</PropertyGroup>

	<Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<GeneratedBuildConfig>$(IntermediateOutputPath)BuildConfig.g.cs</GeneratedBuildConfig>
		</PropertyGroup>
		<!-- One item per line so WriteLinesToFile emits clean C# regardless of XML formatting. -->
		<ItemGroup>
			<BuildConfigLine Include="namespace SourceBase.Desktop%3B" />
			<BuildConfigLine Include="/// &lt;summary&gt;Injected at build time from the API_URL env var. Do not edit — generated by MSBuild.&lt;/summary&gt;" />
			<BuildConfigLine Include="internal static class BuildConfig" />
			<BuildConfigLine Include="{" />
			<BuildConfigLine Include="    public const string ApiBaseUrl = &quot;$(JupiterApiBaseUrl)&quot;%3B" />
			<BuildConfigLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(GeneratedBuildConfig)" Lines="@(BuildConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(GeneratedBuildConfig)" />
			<FileWrites Include="$(GeneratedBuildConfig)" />
		</ItemGroup>
	</Target>

</Project>