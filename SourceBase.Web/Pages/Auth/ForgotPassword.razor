@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ApiHttpClient Api

<h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Forgot your password?</h2>
<p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Enter your email and we'll send you a reset code.</p>

@if (_success)
{
    <div class="rounded-md bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 px-4 py-4 text-sm text-green-700 dark:text-green-400">
        <p class="font-medium">Check your email</p>
        <p class="mt-1">If an account with that email exists, we've sent a password reset code.</p>
        <div class="mt-3">
            <a href="/reset-password?email=@Uri.EscapeDataString(_email)" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 font-medium">Enter reset code →</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <div class="space-y-4">
            <div>
                <label class="form-label">Email</label>
                <InputText @bind-Value="_model.Email" class="form-input" type="email" placeholder="you@example.com" autocomplete="email" />
            </div>
        </div>

        <div class="mt-6">
            <button type="submit" class="btn-primary w-full" disabled="@_loading">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                @(_loading ? "Sending…" : "Send reset code")
            </button>
        </div>
    </EditForm>
}

<div class="mt-4 text-center">
    <a href="/login" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300">← Back to sign in</a>
</div>

@code {
    private readonly ForgotFormModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _success;
    private string _email = string.Empty;

    private async Task SubmitAsync()
    {
        _error = null;
        _loading = true;
        _email = _model.Email;
        await Api.ForgotPasswordAsync(_model.Email);
        _success = true;
        _loading = false;
    }

    private sealed class ForgotFormModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
