@inject ApiHttpClient Api

@if (IsVisible)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="HandleClose"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-1">Reset Password</h2>
            <p class="text-sm text-gray-500 mb-4">Resetting password for <strong>@User?.UserName</strong>. Copy the password below before submitting — it won't be shown again.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="mb-3 rounded-md bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700">@_error</div>
            }

            <div>
                <label class="form-label">New Password</label>
                <div class="flex gap-2">
                    <input value="@_password" class="form-input flex-1" type="text" readonly />
                    <button class="btn-secondary btn-sm" @onclick="Regenerate">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Regenerate
                    </button>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-5">
                <button class="btn-secondary" @onclick="HandleClose">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
                <button class="btn-primary" @onclick="SubmitAsync" disabled="@_submitting">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    @(_submitting ? "Sending…" : "Reset & Email")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool IsVisible { get; set; }
    [Parameter, EditorRequired] public UserResponse? User { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _prevIsVisible;
    private string _password = string.Empty;
    private string? _error;
    private bool _submitting;

    protected override void OnParametersSet()
    {
        if (IsVisible && !_prevIsVisible)
        {
            _password = GeneratePassword();
            _error = null;
        }
        _prevIsVisible = IsVisible;
    }

    private void Regenerate() => _password = GeneratePassword();

    private async Task SubmitAsync()
    {
        _error = null;
        _submitting = true;
        var error = await Api.ResetUserPasswordAsync(User!.Id, _password);
        if (error is not null)
        {
            _error = error.Message ?? "Failed to reset password.";
            _submitting = false;
            return;
        }
        _submitting = false;
        await OnSaved.InvokeAsync();
    }

    private Task HandleClose() => OnClose.InvokeAsync();

    private static string GeneratePassword()
    {
        const string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string lower = "abcdefghijklmnopqrstuvwxyz";
        const string digits = "0123456789";
        const string special = "!@#$%^&*";
        const string all = upper + lower + digits + special;
        var rng = new Random();
        var chars = new char[12];
        chars[0] = upper[rng.Next(upper.Length)];
        chars[1] = lower[rng.Next(lower.Length)];
        chars[2] = digits[rng.Next(digits.Length)];
        chars[3] = special[rng.Next(special.Length)];
        for (var i = 4; i < 12; i++)
            chars[i] = all[rng.Next(all.Length)];
        return new string(chars.OrderBy(_ => rng.Next()).ToArray());
    }
}
