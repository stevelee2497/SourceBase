@inject ApiHttpClient Api
@inject NotificationService NotificationService
@implements IAsyncDisposable

<div class="relative">
    <button class="relative p-1.5 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors" @onclick="ToggleDropdown" aria-label="Notifications">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        @if (NotificationService.UnreadCount > 0)
        {
            <span class="absolute top-0.5 right-0.5 w-2 h-2 bg-red-500 rounded-full"></span>
        }
    </button>

    @if (_open)
    {
        <div class="absolute right-0 top-full mt-1 w-80 bg-white rounded-md shadow-lg border border-gray-200 z-50">
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-gray-100">
                <span class="text-sm font-semibold text-gray-800">Notifications</span>
                <div class="flex gap-2">
                    @if (NotificationService.UnreadCount > 0)
                    {
                        <button class="text-xs text-indigo-600 hover:text-indigo-800 transition-colors" @onclick="MarkAllReadAsync">Mark all read</button>
                    }
                    @if (NotificationService.Notifications.Count > 0)
                    {
                        <button class="text-xs text-red-500 hover:text-red-700 transition-colors" @onclick="ClearAllAsync">Clear all</button>
                    }
                </div>
            </div>

            <div class="max-h-80 overflow-y-auto">
                @if (NotificationService.Notifications.Count == 0)
                {
                    <div class="px-4 py-6 text-center text-sm text-gray-400">No notifications</div>
                }
                else
                {
                    @foreach (var notification in NotificationService.Notifications)
                    {
                        <button class="@NotificationClass(notification) w-full text-left px-4 py-3 hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-0" @onclick="MarkReadAsync(notification)">
                            <div class="flex items-start gap-2">
                                @if (!notification.IsRead)
                                {
                                    <span class="mt-1.5 w-2 h-2 bg-indigo-500 rounded-full shrink-0"></span>
                                }
                                else
                                {
                                    <span class="mt-1.5 w-2 h-2 shrink-0"></span>
                                }
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">@notification.Title</p>
                                    <p class="text-xs text-gray-500 mt-0.5">@notification.Message</p>
                                    <p class="text-xs text-gray-400 mt-1">@FormatTime(notification.CreatedOn)</p>
                                </div>
                            </div>
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChange += OnNotifChanged;
        var (result, _) = await Api.GetNotificationsAsync();
        if (result is not null)
            NotificationService.SetNotifications(result.Items);
        await NotificationService.StartAsync();
    }

    private void ToggleDropdown() => _open = !_open;

    private Func<Task> MarkReadAsync(NotificationResponse notification) => async () =>
    {
        if (notification.IsRead) return;
        NotificationService.MarkReadLocally(notification.Id);
        await Api.MarkNotificationAsReadAsync(notification.Id);
    };

    private async Task MarkAllReadAsync()
    {
        NotificationService.MarkAllReadLocally();
        await Api.MarkAllNotificationsAsReadAsync();
    }

    private async Task ClearAllAsync()
    {
        NotificationService.ClearLocally();
        await Api.ClearAllNotificationsAsync();
        _open = false;
    }

    private void OnNotifChanged() => InvokeAsync(StateHasChanged);

    private static string NotificationClass(NotificationResponse n) =>
        n.IsRead ? "opacity-70" : "bg-indigo-50/40";

    private static string FormatTime(DateTime? dt) =>
        dt is null ? string.Empty : dt.Value.ToLocalTime().ToString("MMM d, HH:mm");

    public async ValueTask DisposeAsync()
    {
        NotificationService.OnChange -= OnNotifChanged;
        await NotificationService.StopAsync();
    }
}
