@page "/gold-prices"
@attribute [Authorize]
@inject ApiHttpClient Api
@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<div class="flex flex-col gap-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Gold Prices</h2>
        <p class="text-xs text-gray-400">Nhẫn tròn 9999 · 1 chỉ · VND</p>
    </div>

    <!-- Filters -->
    <div class="card p-4">
        <div class="flex flex-wrap gap-3 items-end">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">Source</label>
                <select class="input-field text-sm h-9 min-w-36" value="@_sourceFilter" @onchange="OnSourceChanged">
                    <option value="">All Sources</option>
                    @foreach (var src in _sources)
                    {
                        <option value="@src">@src</option>
                    }
                </select>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">From</label>
                <input type="date" class="input-field text-sm h-9" value="@_dateFromStr" @onchange="OnDateFromChanged" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">To</label>
                <input type="date" class="input-field text-sm h-9" value="@_dateToStr" @onchange="OnDateToChanged" />
            </div>
            <button class="btn-secondary btn-sm h-9" @onclick="ResetFiltersAsync">Clear</button>
        </div>
    </div>

    <!-- Chart -->
    <div class="card p-4">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Price Trend (last 7 days)</h3>
        @if (_loadingChart)
        {
            <LoadingSpinner />
        }
        else if (_chartData.Count == 0)
        {
            <p class="text-sm text-gray-400 text-center py-6">No data to display.</p>
        }
        else
        {
            <div id="gold-price-chart" class="w-full"></div>
        }
    </div>

    <!-- Table -->
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_tableData is not null)
    {
        <div class="card p-0 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recorded At</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Buy Price</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Sell Price</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        @if (_tableData.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="px-4 py-8 text-center text-sm text-gray-400">No gold price records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _tableData.Items)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3 text-sm text-gray-700">@item.RecordedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="px-4 py-3">
                                        <span class="@GetSourceBadgeClass(item.Source) text-xs font-medium px-2 py-0.5 rounded-full">@item.Source</span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-right font-mono text-gray-800">@item.BuyPrice.ToString("N0")</td>
                                    <td class="px-4 py-3 text-sm text-right font-mono text-gray-800">@item.SellPrice.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <Pagination CurrentPage="_page" TotalItems="_tableData.Total" PageSize="_pageSize" OnPageChanged="ChangePage" />
    }

</div>

@code {
    private PagingResponse<GoldPriceResponse>? _tableData;
    private List<GoldPriceResponse> _chartData = [];
    private readonly string[] _sources = ["SJC", "PNJ", "GiaVang", "KimKhanhVietHung"];
    private bool _loading = true;
    private bool _loadingChart = true;
    private string? _error;
    private string _sourceFilter = string.Empty;
    private string _dateFromStr = string.Empty;
    private string _dateToStr = string.Empty;
    private int _page = 1;
    private const int _pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTableDataAsync(), LoadChartDataAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadingChart && _chartData.Count > 0)
            await RenderChartAsync();
    }

    private async Task LoadTableDataAsync()
    {
        _loading = true;
        var dateFrom = string.IsNullOrWhiteSpace(_dateFromStr) ? null : _dateFromStr + "T00:00:00Z";
        var dateTo = string.IsNullOrWhiteSpace(_dateToStr) ? null : _dateToStr + "T23:59:59Z";
        var (data, error) = await Api.GetGoldPricesAsync(_page, _pageSize, string.IsNullOrEmpty(_sourceFilter) ? null : _sourceFilter, dateFrom, dateTo);
        _tableData = data;
        _error = error?.Message;
        _loading = false;
    }

    private async Task LoadChartDataAsync()
    {
        _loadingChart = true;
        var sevenDaysAgo = DateTime.UtcNow.AddDays(-7).ToString("yyyy-MM-dd") + "T00:00:00Z";
        var (data, _) = await Api.GetGoldPricesAsync(1, 500, null, sevenDaysAgo, null);
        _chartData = data?.Items ?? [];
        _loadingChart = false;
    }

    private async Task RenderChartAsync()
    {
        var seriesMap = new Dictionary<string, List<object[]>>();
        foreach (var src in _sources)
        {
            seriesMap[$"{src} Buy"] = [];
            seriesMap[$"{src} Sell"] = [];
        }
        foreach (var item in _chartData.OrderBy(x => x.RecordedAt))
        {
            var ts = item.RecordedAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm:ss");
            seriesMap[$"{item.Source} Buy"].Add([ts, item.BuyPrice]);
            seriesMap[$"{item.Source} Sell"].Add([ts, item.SellPrice]);
        }
        var series = seriesMap
            .Where(kv => kv.Value.Count > 0)
            .Select(kv => new { name = kv.Key, data = kv.Value })
            .ToArray();
        await JS.InvokeVoidAsync("renderGoldPriceChart", "gold-price-chart", series);
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadTableDataAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _sourceFilter = string.Empty;
        _dateFromStr = string.Empty;
        _dateToStr = string.Empty;
        _page = 1;
        await LoadTableDataAsync();
    }

    private void OnSourceChanged(ChangeEventArgs e)
    {
        _sourceFilter = e.Value?.ToString() ?? string.Empty;
        _ = ApplyFiltersAsync();
    }

    private void OnDateFromChanged(ChangeEventArgs e)
    {
        _dateFromStr = e.Value?.ToString() ?? string.Empty;
        _ = ApplyFiltersAsync();
    }

    private void OnDateToChanged(ChangeEventArgs e)
    {
        _dateToStr = e.Value?.ToString() ?? string.Empty;
        _ = ApplyFiltersAsync();
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadTableDataAsync();
    }

    private static string GetSourceBadgeClass(string source) => source switch
    {
        "SJC" => "bg-indigo-100 text-indigo-700",
        "PNJ" => "bg-amber-100 text-amber-700",
        "GiaVang" => "bg-green-100 text-green-700",
        "KimKhanhVietHung" => "bg-rose-100 text-rose-700",
        _ => "bg-gray-100 text-gray-700",
    };
}
