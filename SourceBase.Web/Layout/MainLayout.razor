@inject BlazorAuthStateProvider AuthStateProvider
@inject ApiHttpClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject AppSettings AppSettings
@inherits LayoutComponentBase
@implements IDisposable

<div class="flex h-screen bg-gray-50">
    <NavMenu MobileOpen="_mobileMenuOpen" OnMobileClose="CloseMobileMenu" />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <div class="flex items-center h-16 px-4 md:px-6 bg-white border-b border-gray-200 shrink-0 gap-3">
            <!-- Hamburger (mobile only) -->
            <button class="md:hidden p-1.5 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100" @onclick="OpenMobileMenu" aria-label="Open menu">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <div class="flex-1 text-base md:text-2xl truncate max-w-full font-semibold text-gray-800">
                @GetPageTitle()
            </div>
            <div class="flex items-center gap-2 md:gap-3 shrink-0">
                <NotificationBell />
                <AuthorizeView>
                    <Authorized>
                        <div class="relative group">
                            <button class="flex items-center gap-2 px-3 py-1.5 rounded-md text-sm text-gray-700 hover:bg-gray-100 transition-colors">
                                @if (!string.IsNullOrEmpty(AuthStateProvider.UserInfo?.AvatarUrl))
                                {
                                    <img src="@AuthStateProvider.UserInfo.AvatarUrl" alt="Avatar" class="w-6 h-6 rounded-full object-cover shrink-0" />
                                }
                                else
                                {
                                    <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                }
                                <span class="truncate max-w-25 font-semibold">@_displayName</span>
                                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div class="absolute right-0 top-full mt-1 w-48 bg-white rounded-md shadow-lg border border-gray-200 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 z-50">
                                <div class="py-1">
                                    <button @onclick="OpenEditCurrentUserAsync" class="flex items-center gap-3 w-full px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
                                        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                        Edit User
                                    </button>
                                    <div class="my-1 border-t border-gray-100"></div>
                                    <button @onclick="LogoutAsync" class="flex items-center gap-3 w-full px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                        </svg>
                                        Sign Out
                                    </button>
                                </div>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Main content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6">
            @Body
        </main>
    </div>
</div>

<UserModal IsVisible="@_showEditCurrentUser" User="@AuthStateProvider.UserInfo" AllRoles="@_allRoles" OnClose="CloseEditCurrentUser" OnSaved="OnCurrentUserSavedAsync" />

@code {
    private bool _mobileMenuOpen;
    private bool _showEditCurrentUser;
    private string _displayName = string.Empty;
    private List<RoleResponse> _allRoles = [];

    private void OpenMobileMenu() => _mobileMenuOpen = true;
    private void CloseMobileMenu() => _mobileMenuOpen = false;
    private void CloseEditCurrentUser() => _showEditCurrentUser = false;


    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;

        var userInfo = AuthStateProvider.UserInfo;
        if (userInfo is not null)
            _displayName = $"{userInfo.FirstName} {userInfo.LastName}".Trim();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> _) => InvokeAsync(() =>
    {
        var userInfo = AuthStateProvider.UserInfo;
        if (userInfo is not null)
            _displayName = $"{userInfo.FirstName} {userInfo.LastName}".Trim();
        StateHasChanged();
    });

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task OpenEditCurrentUserAsync()
    {
        if (_allRoles.Count == 0)
        {
            var (result, _) = await Api.GetRolesAsync(1, 100);
            _allRoles = result?.Items ?? [];
        }
        _showEditCurrentUser = true;
    }

    private async Task OnCurrentUserSavedAsync()
    {
        _showEditCurrentUser = false;
        var (userInfo, _) = await Api.GetUserInfoAsync();
        if (userInfo is not null)
        {
            AuthStateProvider.SetUserInfo(userInfo);
            _displayName = $"{userInfo.FirstName} {userInfo.LastName}".Trim();
        }
    }

    private async Task LogoutAsync()
    {
        if (!string.IsNullOrWhiteSpace(AuthStateProvider.AccessToken))
            await Api.LogoutAsync();

        await AuthStateProvider.SignOutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetPageTitle()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        var allPages = AppSettings.Pages.Concat(AppSettings.Pages.SelectMany(p => p.SubPages));
        return allPages.FirstOrDefault(p => p.Url == path)?.Title ?? "SourceBase";
    }
}
