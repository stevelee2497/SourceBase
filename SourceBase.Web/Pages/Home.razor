@page "/"
@attribute [Authorize]
@implements IDisposable
@inject BlazorAuthStateProvider Auth
@inject AuthenticationStateProvider AuthProvider
@inject ApiHttpClient Api
@inject HttpClient Http
@using System.Globalization
@using System.Net.Http.Json

<!-- Overall section -->
<h2 class="text-base font-semibold text-blue-800 dark:text-blue-400 mb-2">Overall</h2>
<!-- Overview row -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-2 md:gap-4 mb-2 md:mb-4">
    <!-- Log time status -->
    <div class="card flex flex-col justify-between gap-0 p-2 md:p-4">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Log Time</div>
        @if (_statsLoading)
        {
            <div class="text-sm text-gray-400 dark:text-gray-500">Loading…</div>
        }
        else
        {
            <div class="flex items-center gap-2 justify-center">
                <div class="w-3 h-3 rounded-full shrink-0 @(_stats?.AllLogged == true ? "bg-green-500" : "bg-red-500")"></div>
                <span class="text-base md:text-lg font-semibold @(_stats?.AllLogged == true ? "text-green-700 dark:text-green-400" : "text-red-700 dark:text-red-400")">@(_stats?.AllLogged == true ? "Logged" : "Not logged")</span>
            </div>
            <div class="text-xs text-right text-gray-400 dark:text-gray-500">@(_stats?.LogTimeDetail)</div>
        }
    </div>

    <!-- Total users (admin only) -->
    <AuthorizeView Roles="Admin">
        <div class="card flex flex-col justify-between gap-0 p-2 md:p-4">
            <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Users</div>
            <div class="text-2xl font-bold text-center text-indigo-600 dark:text-indigo-400">@(_stats?.UserCount ?? 0)</div>
            <a href="/users" class="text-xs text-right text-indigo-500 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">Manage</a>
        </div>
    </AuthorizeView>

    <!-- Total balance -->
    <div class="card flex flex-col gap-0 p-2 md:p-4">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">Total Balance</div>
        @if (_statsLoading)
        {
            <div class="text-sm text-gray-400 dark:text-gray-500">Loading…</div>
        }
        else
        {
            <div class="text-md md:text-lg text-center font-bold text-green-600 dark:text-green-400 mt-1 md:mt-4">@FormatAmount(_stats?.TotalBalance ?? 0)</div>
        }
    </div>

    <!-- Monthly income / expense -->
    <div class="card flex flex-col gap-2 p-2 md:p-4">
        <div class="text-sm font-medium text-gray-500 dark:text-gray-400">This Month</div>
        @if (_statsLoading)
        {
            <div class="text-sm text-gray-400 dark:text-gray-500">Loading…</div>
        }
        else
        {
            <div class="flex flex-col gap-1">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-500 dark:text-gray-400">Income</span>
                    <span class="text-xs md:text-base font-semibold text-green-600 dark:text-green-400">+@FormatAmount(_stats?.MonthlyIncome ?? 0)</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs text-gray-500 dark:text-gray-400">Expenses</span>
                    <span class="text-xs md:text-base font-semibold text-red-600 dark:text-red-400">-@FormatAmount(_stats?.MonthlyExpense ?? 0)</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- Habits section -->
<a href="/habit-logs" class="block text-base font-semibold text-blue-800 dark:text-blue-400 mb-2 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors mt-4">Habits</a>
<!-- Habits cards row -->
<div class="grid grid-cols-4 lg:grid-cols-5 gap-2 md:gap-4 mb-2 md:mb-4">
    @if (_habitsLoading)
    {
        <div class="col-span-4 lg:col-span-5 text-sm text-gray-400 dark:text-gray-500">Loading…</div>
    }
    else if (_habits.Count == 0)
    {
        <div class="col-span-4 lg:col-span-5 text-sm text-gray-400 dark:text-gray-500 py-2">No habits yet.</div>
    }
    else
    {
        @for (var i = 0; i < _habits.Count; i++)
        {
            var habit = _habits[i];
            var cardText = HabitCardTextColors[i % HabitCardTextColors.Length];
            <button class="flex flex-col items-center gap-1 hover:opacity-75 transition-opacity disabled:opacity-50" @onclick="LogHabit(habit)" disabled="@_loggingHabitId.HasValue" title="Log @habit.Name">
                <div class="w-9 h-9 md:w-14 md:h-14 rounded-full bg-white/70 dark:bg-gray-800/70 flex items-center justify-center text-xl md:text-3xl shrink-0">
                    @(string.IsNullOrEmpty(habit.Icon) ? "💪" : habit.Icon)
                </div>
                <div class="flex items-center justify-center gap-1 w-full min-w-0">
                    <span class="text-xs md:text-lg font-medium text-center @cardText truncate"> @habit.LogCount @habit.Name.ToLower() </span>
                </div>
            </button>
        }
    }
</div>

<!-- Gold section -->
<a href="/gold-prices" class="block text-base font-semibold text-blue-800 dark:text-blue-400 mb-2 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors mt-4">Gold</a>
<!-- Gold price status row -->
<div class="grid grid-cols-3 lg:grid-cols-6 gap-2 md:gap-4 mb-2 md:mb-4">
    @foreach (var source in GoldSources)
    {
        var record = _goldPrices.GetValueOrDefault(source);
        var live = IsGoldPriceLive(record);
        <div class="card p-2 md:p-4 flex flex-col gap-0 md:gap-2 @GetGoldSourceCardClass(source)">
            <div class="flex items-center justify-between gap-1">
                <span class="text-xs md:text-base font-bold truncate @GetGoldSourceBadgeClass(source)">@GetGoldSourceDisplayName(source)</span>
                <span class="text-[10px] text-right @(live ? "text-green-700 dark:text-green-400" : "text-red-700 dark:text-red-400")">@(live ? "🟢" : "🔴")</span>
            </div>
            @if (_goldPricesLoading)
            {
                <div class="text-sm text-gray-400 dark:text-gray-500">Loading…</div>
            }
            else if (record is null)
            {
                <div class="text-sm text-gray-400 dark:text-gray-500">No data</div>
            }
            else
            {
                <div class="text-sm lg:text-lg text-center font-bold text-emerald-600 dark:text-emerald-400">@FormatAmount(@record.SellPrice)</div>
                @if (source == "GiaVang")
                {
                    @if (_goldUsdPriceLoading)
                    {
                        <div class="text-[11px] lg:text-md font-semibold text-right text-orange-500 dark:text-orange-400">Loading…</div>
                    }
                    else
                    {
                        <div class="text-[11px] lg:text-md font-semibold text-right text-orange-500 dark:text-orange-400">$@(_goldUsdPrice.HasValue ? _goldUsdPrice.Value.ToString("N0") : "—")</div>
                    }
                }
                else
                {
                    <div class="text-[11px] lg:text-md font-semibold text-right text-red-600 dark:text-red-400">@FormatAmount(@record.BuyPrice)</div>
                }
            }
        </div>
    }
    <div class="card p-2 md:p-4 flex flex-col gap-0 md:gap-2 bg-orange-50 dark:bg-orange-900/30">
        <div class="flex items-center justify-between gap-1">
            <span class="text-xs md:text-base font-bold truncate text-orange-700 dark:text-orange-400">BTC/USDT</span>
            <span class="text-[10px] text-right @(_btcPrice is not null ? "text-green-700 dark:text-green-400" : "text-red-700 dark:text-red-400")">@(_btcPrice is not null ? "🟢" : "🔴")</span>
        </div>
        @if (_btcPriceLoading)
        {
            <div class="text-sm text-gray-400 dark:text-gray-500">Loading…</div>
        }
        else if (_btcPrice is null)
        {
            <div class="text-sm text-gray-400 dark:text-gray-500">No data</div>
        }
        else
        {
            <div class="text-sm lg:text-2xl text-center font-bold text-emerald-600 dark:text-emerald-400">$@FormatAmount(_btcPrice.Value)</div>
        }
    </div>
</div>

<!-- Wallets -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-2 md:gap-4">
    <div class="flex flex-col">
        <!-- Left: Wallets distribution -->
        <a href="/wallets" class="block text-base font-semibold text-blue-800 dark:text-blue-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors mt-4 mb-2">Wallets</a>
        <div class="card flex flex-col gap-2 p-2 md:p-4 flex-1">

            @if (_walletsLoading)
            {
                <LoadingSpinner />
            }
            else if (_wallets is null || _wallets.Wallets.Count == 0)
            {
                <div class="py-6 text-center">
                    <div class="text-sm text-gray-400 dark:text-gray-500 mb-2">No wallets yet.</div>
                    <a href="/wallets" class="btn-primary btn-sm">Create Wallet</a>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center gap-4">
                    <div class="shrink-0">
                        @{
                            var pieData = BuildWalletPieData();
                        }
                        <svg width="200" height="200" viewBox="-1.02 -1.02 2.04 2.04" style="transform: rotate(-90deg)">
                            @if (pieData.Count == 1)
                            {
                                <circle cx="0" cy="0" r="1" fill="@pieData[0].Color" />
                            }
                            else
                            {
                                double cumulative = 0;
                                foreach (var slice in pieData)
                                {
                                    var startAngle = cumulative * 2 * Math.PI;
                                    cumulative += slice.Fraction;
                                    var endAngle = cumulative * 2 * Math.PI;
                                    var x1 = Math.Cos(startAngle);
                                    var y1 = Math.Sin(startAngle);
                                    var x2 = Math.Cos(endAngle);
                                    var y2 = Math.Sin(endAngle);
                                    var largeArc = slice.Fraction > 0.5 ? 1 : 0;
                                    var pathD = $"M 0 0 L {x1:F4} {y1:F4} A 1 1 0 {largeArc} 1 {x2:F4} {y2:F4} Z";
                                    <path d="@pathD" fill="@slice.Color" stroke="white" stroke-width="0.02" />
                                }
                            }
                        </svg>
                    </div>
                    <div class="flex flex-wrap gap-x-4 gap-y-2 justify-center">
                        @foreach (var slice in BuildWalletPieData())
                        {
                            var wallet = _wallets.Wallets.FirstOrDefault(w => w.Name == slice.Name);
                            <div class="flex items-center gap-1.5 text-sm">
                                <div class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: @slice.Color"></div>
                                <span class="text-gray-700 dark:text-gray-200 font-medium">@slice.Name</span>
                                <span class="text-gray-500 dark:text-gray-400">@FormatAmount(wallet?.Balance ?? 0)</span>
                            </div>
                        }
                    </div>
                    <div class="flex items-center justify-center gap-1.5 pt-1 border-t border-gray-100 dark:border-gray-700">
                        <span class="text-sm text-gray-500 dark:text-gray-400 mt-3">Total</span>
                        <span class="text-sm font-semibold text-gray-800 dark:text-gray-200 mt-3">@FormatAmount(_wallets.TotalBalance)</span>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="flex flex-col">
        <!-- Right: Default todo list -->
        <a href="/todos" class="block text-base font-semibold text-blue-800 dark:text-blue-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors mt-4 mb-2">Todo</a>
        <div class="card flex flex-col gap-2 py-1 px-2 flex-1">

            @if (_todosLoading)
            {
                <LoadingSpinner />
            }
            else if (Auth.UserInfo?.DefaultTodoListId is null)
            {
                <div class="py-6 text-center">
                    <div class="text-sm text-gray-400 dark:text-gray-500 mb-2">No default list set.</div>
                    <a href="/todos" class="btn-primary btn-sm">Go to Todos to star a list</a>
                </div>
            }
            else
            {
                @if (_defaultTodos.Count == 0)
                {
                    <div class="text-sm text-gray-400 dark:text-gray-500 text-center py-4">No open todos in this list.</div>
                }
                else
                {
                    <div class="flex flex-col">
                        @foreach (var (todo, index) in _defaultTodos.Take(10).Select((t, i) => (t, i)))
                        {
                            @if (index > 0)
                            {
                                <div class="border-t border-gray-100 dark:border-gray-700"></div>
                            }
                            var completing = _completingTodoIds.Contains(todo.Id);
                            <div class="flex items-center gap-3 ml-2 py-2 transition-opacity duration-300 @(completing ? "opacity-0" : "opacity-100")">
                                <button class="shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors duration-200 @(completing ? "border-green-500 bg-green-500 animate-todo-check-pop" : "border-gray-400 dark:border-gray-600 hover:border-green-500")" @onclick="ToggleTodoDone(todo)" title="Mark complete" disabled="@completing">
                                    @if (completing)
                                    {
                                        <svg class="w-3 h-3 text-white animate-todo-check-draw" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                        </svg>
                                    }
                                </button>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm truncate transition-colors duration-200 @(completing ? "text-gray-400 dark:text-gray-500 line-through" : "text-gray-800 dark:text-gray-200")">@todo.Title</div>
                                    <div class="text-xs text-gray-400 dark:text-gray-500">@todo.Date</div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_defaultTodos.Count > 10)
                    {
                        <a href="/todos" class="text-xs text-indigo-500 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">+@(_defaultTodos.Count - 10) more →</a>
                    }
                }
            }
        </div>
    </div>

</div>

@code {
    private StatsResponse? _stats;
    private GetWalletsResponse? _wallets;
    private List<TodoItemResponse> _defaultTodos = [];
    private readonly HashSet<Guid> _completingTodoIds = [];
    private bool _statsLoading = true;
    private bool _walletsLoading = true;
    private bool _todosLoading = true;

    private static readonly string[] GoldSources = ["SJC", "PNJ", "KimKhanhVietHung", "NgocThinh", "GiaVang"];
    private Dictionary<string, GoldPriceResponse?> _goldPrices = new();
    private bool _goldPricesLoading = true;

    private decimal? _btcPrice;
    private bool _btcPriceLoading = true;

    private decimal? _goldUsdPrice;
    private bool _goldUsdPriceLoading = true;

    private List<HabitItemResponse> _habits = [];
    private bool _habitsLoading = true;
    private Guid? _loggingHabitId;

    private static readonly string[] HabitCardTextColors = ["text-indigo-700 dark:text-indigo-400", "text-amber-700 dark:text-amber-400", "text-green-700 dark:text-green-400", "text-rose-700 dark:text-rose-400", "text-purple-700 dark:text-purple-400", "text-teal-700 dark:text-teal-400", "text-blue-700 dark:text-blue-400", "text-orange-700 dark:text-orange-400"];

    private static readonly string[] PieColors = ["#6366f1", "#8b5cf6", "#ec4899", "#f43f5e", "#f97316", "#eab308", "#22c55e", "#06b6d4", "#3b82f6", "#a855f7"];

    private record PieSlice(string Name, double Fraction, string Color);

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await Task.Yield();
        await Task.WhenAll(LoadStatsAsync(), LoadWalletsAsync(), LoadDefaultTodosAsync(), LoadGoldPricesAsync(), LoadHabitsAsync(), LoadBtcPriceAsync(), LoadGoldUsdPriceAsync());
    }

    public void Dispose() => AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;

    private void OnAuthStateChanged(Task<AuthenticationState> _) => InvokeAsync(RefreshAuthDrivenStateAsync);

    private async Task RefreshAuthDrivenStateAsync()
    {
        await LoadDefaultTodosAsync();
        StateHasChanged();
    }

    private async Task LoadHabitsAsync()
    {
        _habitsLoading = true;
        var (data, _) = await Api.GetHabitsAsync(DateTime.Today.ToUniversalTime(), DateTime.Today.AddDays(1).AddTicks(-1).ToUniversalTime());
        _habits = data ?? [];
        _habitsLoading = false;
    }

    private async Task LoadGoldPricesAsync()
    {
        _goldPricesLoading = true;
        var (result, _) = await Api.GetGoldPricesAsync(latest: true);
        _goldPrices = result?.Items.ToDictionary(r => r.Source, r => (GoldPriceResponse?)r) ?? new();
        _goldPricesLoading = false;
    }

    private async Task LoadBtcPriceAsync()
    {
        _btcPriceLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<BinanceTickerPriceResponse>("https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT");
            _btcPrice = decimal.TryParse(response?.Price, NumberStyles.Number, CultureInfo.InvariantCulture, out var price) ? price : null;
        }
        catch
        {
            _btcPrice = null;
        }
        _btcPriceLoading = false;
    }

    private async Task LoadGoldUsdPriceAsync()
    {
        _goldUsdPriceLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<GoldApiPriceResponse>("https://api.gold-api.com/price/XAU");
            _goldUsdPrice = response?.Price is > 0 ? (decimal)response.Price : null;
        }
        catch
        {
            _goldUsdPrice = null;
        }
        _goldUsdPriceLoading = false;
    }

    private record BinanceTickerPriceResponse(string Symbol, string Price);
    private record GoldApiPriceResponse(string Symbol, double Price);

    private static bool IsGoldPriceLive(GoldPriceResponse? record) =>
        record is not null && (DateTime.UtcNow - record.RecordedAt).TotalHours < 2;

    private static string GetGoldSourceDisplayName(string source) => source switch
    {
        "GiaVang" => "Thế giới",
        "KimKhanhVietHung" => "KKVH",
        "NgocThinh" => "Ngọc Thịnh",
        _ => source,
    };

    private static string GetGoldSourceBadgeClass(string source) => source switch
    {
        "SJC" => "text-indigo-700 dark:text-indigo-400",
        "PNJ" => "text-amber-700 dark:text-amber-400",
        "GiaVang" => "text-green-700 dark:text-green-400",
        "KimKhanhVietHung" => "text-rose-700 dark:text-rose-400",
        "NgocThinh" => "text-purple-700 dark:text-purple-400",
        _ => "text-gray-700 dark:text-gray-300",
    };

    private static string GetGoldSourceCardClass(string source) => source switch
    {
        "SJC" => "bg-indigo-50 dark:bg-indigo-900/30",
        "PNJ" => "bg-amber-50 dark:bg-amber-900/30",
        "GiaVang" => "bg-green-50 dark:bg-green-900/30",
        "KimKhanhVietHung" => "bg-rose-50 dark:bg-rose-900/30",
        "NgocThinh" => "bg-purple-50 dark:bg-purple-900/30",
        _ => "",
    };

    private async Task LoadStatsAsync()
    {
        _statsLoading = true;
        var (data, _) = await Api.GetStatsAsync();
        _stats = data;
        _statsLoading = false;
    }

    private async Task LoadWalletsAsync()
    {
        _walletsLoading = true;
        var (data, _) = await Api.GetWalletsAsync();
        _wallets = data;
        _walletsLoading = false;
    }

    private async Task LoadDefaultTodosAsync()
    {
        _todosLoading = true;
        var defaultId = Auth.UserInfo?.DefaultTodoListId;
        if (defaultId is null)
        {
            _defaultTodos = [];
            _todosLoading = false;
            return;
        }

        var (data, _) = await Api.GetTodosAsync(1, 100, defaultId, "Date", "Desc");
        _defaultTodos = data?.Items.Where(t => t.Status != "Completed").ToList() ?? [];
        _todosLoading = false;
    }

    private Func<Task> ToggleTodoDone(TodoItemResponse todo) => async () =>
    {
        _completingTodoIds.Add(todo.Id);
        await Task.Delay(350);
        _completingTodoIds.Remove(todo.Id);

        var dateStr = DateOnly.TryParse(todo.Date, out var d) ? d.ToString("yyyy-MM-dd") : todo.Date;
        var error = await Api.UpdateTodoAsync(todo.Id, todo.Title, dateStr, "Completed");
        if (error is null)
            _defaultTodos.Remove(todo);
    };

    private Func<Task> LogHabit(HabitItemResponse habit) => async () =>
    {
        _loggingHabitId = habit.Id;
        await Api.LogHabitAsync(habit.Id, habit.Name, "HabitStarted");
        _loggingHabitId = null;
        await LoadHabitsAsync();
    };

    private List<PieSlice> BuildWalletPieData()
    {
        if (_wallets is null || _wallets.Wallets.Count == 0) return [];
        var positiveTotal = _wallets.Wallets.Sum(w => Math.Max(0m, w.Balance));
        if (positiveTotal <= 0)
            return _wallets.Wallets.Select((w, i) => new PieSlice(w.Name, 1.0 / _wallets.Wallets.Count, PieColors[i % PieColors.Length])).ToList();
        return _wallets.Wallets
            .Select((w, i) => new PieSlice(w.Name, (double)(Math.Max(0m, w.Balance) / positiveTotal), PieColors[i % PieColors.Length]))
            .Where(s => s.Fraction > 0)
            .ToList();
    }

    private static string FormatAmount(decimal amount) => amount.ToString("N0");
}
