{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowSpecificOrigins": [
    "http://localhost:3000" 
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AppSettings": {
    "AdminEmail": "admin@yopmail.com",
    "AdminPassword": "",
    "Roles": [ "Admin", "User" ],
    "ApiUrl": "http://localhost:3000/api",
    "SendgridApiKey": "",
    "SendGridAccountOwner": "quoctran2124@gmail.com"
  }
}
