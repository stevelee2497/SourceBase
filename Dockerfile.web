FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# Install Node.js 22 (required for @tailwindcss/oxide which needs Node >= 20)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Directory.Packages.props .
COPY Directory.Build.props .
COPY SourceBase.Web/SourceBase.Web.csproj SourceBase.Web/
COPY SourceBase.Web/package.json SourceBase.Web/
COPY SourceBase.Web/package-lock.json SourceBase.Web/
RUN dotnet restore SourceBase.Web/SourceBase.Web.csproj

COPY . .
RUN dotnet publish SourceBase.Web/SourceBase.Web.csproj -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "SourceBase.Web.dll"]
