FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# Install Node.js 22 (required for @tailwindcss/oxide which needs Node >= 20)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN dotnet workload install wasm-tools

COPY Directory.Packages.props .
COPY Directory.Build.props .
COPY SourceBase.Web/SourceBase.Web.csproj SourceBase.Web/
COPY SourceBase.Web/package.json SourceBase.Web/
COPY SourceBase.Web/package-lock.json SourceBase.Web/
RUN dotnet restore SourceBase.Web/SourceBase.Web.csproj

COPY . .

ARG API_URL
RUN echo "{\"ApiBaseUrl\":\"${API_URL}\"}" > SourceBase.Web/wwwroot/appsettings.Production.json

RUN dotnet publish SourceBase.Web/SourceBase.Web.csproj -c Release -o /app/publish

FROM nginx:alpine AS final
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
