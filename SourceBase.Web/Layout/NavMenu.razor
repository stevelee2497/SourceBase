@inject AppSettings AppSettings
@inject BlazorAuthStateProvider Auth
@inject IConfiguration Configuration

<!-- Mobile overlay backdrop -->
@if (MobileOpen)
{
    <div class="fixed inset-0 z-40 bg-black/50 md:hidden" @onclick="CloseMenu"></div>
}

<aside class="@AsideClass w-64 bg-white border-r border-gray-200 flex-col shrink-0">
    <div class="flex items-center justify-between h-16 px-6 border-b border-gray-200">
        <span class="text-xl font-bold text-indigo-600">SourceBase</span>
        <button class="md:hidden p-1 rounded text-gray-400 hover:text-gray-600" @onclick="CloseMenu" aria-label="Close menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 px-4 py-4 space-y-1">
        @foreach (var navPage in AppSettings.Pages)
        {
            if (navPage.Roles.Count() == 0 || navPage.Roles.Any(role => Auth.UserInfo?.Roles.Contains(role) == true))
            {
                <NavLink href="@navPage.Url" Match="@GetNavLinkMatch(navPage.Url)" class="flex items-center px-3 py-2 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors w-full" ActiveClass="bg-indigo-50 text-indigo-700 font-medium">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        @((MarkupString)navPage.Icon)
                    </svg>
                    @navPage.Title
                </NavLink>
                @foreach (var sub in navPage.SubPages)
                {
                    <NavLink href="@sub.Url" class="flex items-center pr-3 py-1.5 rounded-md text-sm text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition-colors w-full" style="padding-left: 25px;" ActiveClass="bg-indigo-50 text-indigo-700 font-medium">
                        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            @((MarkupString)sub.Icon)
                        </svg>
                        @sub.Title
                    </NavLink>
                }
            }
        }
    </nav>

    <div class="py-3 border-t border-gray-100 text-center">
        <span class="text-xs text-gray-400">version @(Configuration["AppVersion"] ?? "1.1")</span>
    </div>
</aside>

@code {
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnMobileClose { get; set; }

    private string AsideClass => MobileOpen ? "fixed inset-y-0 left-0 z-50 flex" : Collapsed ? "hidden" : "hidden md:flex";

    private static NavLinkMatch GetNavLinkMatch(string url) => url == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix;

    private Task CloseMenu() => OnMobileClose.InvokeAsync();
}
