@page "/gold-prices"
@attribute [Authorize]
@implements IDisposable
@inject ApiHttpClient Api
@inject IJSRuntime JS
@inject UserTimeZoneService TimeZoneService

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<div class="flex flex-col gap-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Gold Prices</h2>
        <p class="text-xs text-gray-400">Nhẫn tròn 9999 · 1 chỉ · VND</p>
    </div>

    <!-- Chart -->
    <div class="card p-4">
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Price Trend</h3>
            <div class="flex items-center gap-2">
                <SelectInput @bind-Value="_chartRange" @bind-Value:after="OnChartRangeChangedAsync" Options="ChartRangeOptions" Class="w-36" />
                <SelectInput @bind-Value="_chartSeries" @bind-Value:after="OnChartSeriesChangedAsync" Options="ChartSeriesOptions" Class="w-32" />
            </div>
        </div>
        @if (_loadingChart)
        {
            <LoadingSpinner />
        }
        else if (_chartData.Count == 0)
        {
            <p class="text-sm text-gray-400 text-center py-6">No data to display.</p>
        }
        else
        {
            <div id="gold-price-chart" class="w-full"></div>
        }
    </div>

    <!-- Filters -->
    <div class="card p-4">
        <div class="flex flex-wrap gap-3 items-end">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">Source</label>
                <SelectInput @bind-Value="_sourceFilter" @bind-Value:after="ApplyFiltersAsync" Options="SourceOptions" Class="min-w-36" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">From</label>
                <InputDate @bind-Value="_dateFrom" @bind-Value:after="ApplyFiltersAsync" class="form-input text-sm h-9" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-gray-500">To</label>
                <InputDate @bind-Value="_dateTo" @bind-Value:after="ApplyFiltersAsync" class="form-input text-sm h-9" />
            </div>
            <button class="btn-secondary btn-sm h-9" @onclick="ResetFiltersAsync">Clear</button>
        </div>
    </div>

    <!-- Table -->
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_tableData is not null)
    {
        <div class="card p-0 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Buy Price</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Sell Price</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recorded At</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        @if (_tableData.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="px-4 py-8 text-center text-sm text-gray-400">No gold price records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _tableData.Items)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3">
                                        <span class="@GetSourceBadgeClass(item.Source) text-xs font-medium px-2 py-0.5 rounded-full">@item.Source</span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-right font-mono text-gray-800">@item.BuyPrice.ToString("N0")</td>
                                    <td class="px-4 py-3 text-sm text-right font-mono text-gray-800">@item.SellPrice.ToString("N0")</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">@TimeZoneService.ToLocalTime(item.RecordedAt).ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <Pagination CurrentPage="_page" TotalItems="_tableData.Total" PageSize="_pageSize" OnPageChanged="ChangePage" />
    }

</div>

@code {
    private PagingResponse<GoldPriceResponse>? _tableData;
    private List<GoldPriceResponse> _chartData = [];
    private bool _loading = true;
    private bool _loadingChart = true;
    private bool _chartRendered = false;
    private string? _error;
    private string _sourceFilter = string.Empty;
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private int _page = 1;
    private const int _pageSize = 5;
    private string _chartRange = "7";
    private string _chartSeries = "both";

    private static readonly Dictionary<string, string> _sourceColors = new()
    {
        ["SJC"]              = "#6366f1",
        ["PNJ"]              = "#f59e0b",
        ["GiaVang"]          = "#10b981",
        ["KimKhanhVietHung"] = "#f43f5e",
        ["NgocThinh"]        = "#a855f7",
    };
    private const string _defaultSourceColor = "#6b7280";

    private static readonly IReadOnlyList<SelectOption> SourceOptions =
        new[] { "", "SJC", "PNJ", "GiaVang", "KimKhanhVietHung", "NgocThinh" }
            .Select(s => new SelectOption(s, string.IsNullOrEmpty(s) ? "All Sources" : s))
            .ToList();

    private static readonly IReadOnlyList<SelectOption> ChartRangeOptions =
    [
        new("1",   "Last 24h"),
        new("7",   "Last 7 days"),
        new("30",  "Last 30 days"),
        new("90",  "Last 90 days"),
        new("180", "Last 6 months"),
        new("365", "Last 1 year"),
    ];

    private static readonly IReadOnlyList<SelectOption> ChartSeriesOptions =
    [
        new("both", "Buy & Sell"),
        new("buy",  "Buy only"),
        new("sell", "Sell only"),
    ];

    protected override async Task OnInitializedAsync()
    {
        TimeZoneService.OnChange += OnTimeZoneChanged;
        await Task.WhenAll(LoadTableDataAsync(), LoadChartDataAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loadingChart && _chartData.Count > 0 && !_chartRendered)
        {
            _chartRendered = true;
            await RenderChartAsync();
        }
    }

    private void OnTimeZoneChanged()
    {
        if (_chartRendered)
            _chartRendered = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => TimeZoneService.OnChange -= OnTimeZoneChanged;

    private async Task LoadTableDataAsync()
    {
        _loading = true;
        var dateFrom = _dateFrom.HasValue ? _dateFrom.Value.ToString("yyyy-MM-dd") + "T00:00:00Z" : null;
        var dateTo   = _dateTo.HasValue   ? _dateTo.Value.ToString("yyyy-MM-dd")   + "T23:59:59Z" : null;
        var (data, error) = await Api.GetGoldPricesAsync(_page, _pageSize,
            string.IsNullOrEmpty(_sourceFilter) ? null : _sourceFilter, dateFrom, dateTo);
        _tableData = data;
        _error = error?.Message;
        _loading = false;
    }

    private async Task LoadChartDataAsync()
    {
        _loadingChart = true;
        var days = int.TryParse(_chartRange, out var d) ? d : 7;
        var dateFrom = days == 1
            ? DateTime.UtcNow.AddHours(-24).ToString("yyyy-MM-ddTHH:mm:ssZ")
            : DateTime.UtcNow.AddDays(-days).ToString("yyyy-MM-dd") + "T00:00:00Z";
        var (data, _) = await Api.GetGoldPricesAsync(1, 500, null, dateFrom, null);
        _chartData = data?.Items ?? [];
        _loadingChart = false;
    }

    private async Task RenderChartAsync()
    {
        var seriesMap    = new Dictionary<string, List<object[]>>();
        var seriesColors = new Dictionary<string, string>();
        var seriesDashes = new Dictionary<string, int>();

        foreach (var item in _chartData.OrderBy(x => x.RecordedAt))
        {
            var ts    = TimeZoneService.ToLocalTime(item.RecordedAt).ToString("yyyy-MM-ddTHH:mm:ss");
            var color = _sourceColors.GetValueOrDefault(item.Source, _defaultSourceColor);
            var buyKey  = $"{item.Source} Buy";
            var sellKey = $"{item.Source} Sell";
            if (_chartSeries != "sell")
            {
                if (!seriesMap.ContainsKey(buyKey)) { seriesMap[buyKey] = []; seriesColors[buyKey] = color; seriesDashes[buyKey] = 0; }
                seriesMap[buyKey].Add([ts, item.BuyPrice]);
            }
            if (_chartSeries != "buy")
            {
                if (!seriesMap.ContainsKey(sellKey)) { seriesMap[sellKey] = []; seriesColors[sellKey] = color; seriesDashes[sellKey] = 6; }
                seriesMap[sellKey].Add([ts, item.SellPrice]);
            }
        }

        var keys   = seriesMap.Keys.Where(k => seriesMap[k].Count > 0).ToArray();
        var series = keys.Select(k => new { name = k, data = seriesMap[k] }).ToArray();
        var colors = keys.Select(k => seriesColors[k]).ToArray();
        var dashes = keys.Select(k => seriesDashes[k]).ToArray();
        await JS.InvokeVoidAsync("renderGoldPriceChart", "gold-price-chart", series, colors, dashes);
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadTableDataAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _sourceFilter = string.Empty;
        _dateFrom = null;
        _dateTo = null;
        _page = 1;
        await LoadTableDataAsync();
    }

    private async Task OnChartRangeChangedAsync()
    {
        _chartRendered = false;
        await LoadChartDataAsync();
    }

    private async Task OnChartSeriesChangedAsync()
    {
        _chartRendered = true;
        await RenderChartAsync();
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadTableDataAsync();
    }

    private static string GetSourceBadgeClass(string source) => source switch
    {
        "SJC" => "bg-indigo-100 text-indigo-700",
        "PNJ" => "bg-amber-100 text-amber-700",
        "GiaVang" => "bg-green-100 text-green-700",
        "KimKhanhVietHung" => "bg-rose-100 text-rose-700",
        "NgocThinh" => "bg-purple-100 text-purple-700",
        _ => "bg-gray-100 text-gray-700",
    };
}
