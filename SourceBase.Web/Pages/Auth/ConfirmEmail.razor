@page "/confirm-email"
@layout AuthLayout
@attribute [AllowAnonymous]
@implements IDisposable
@inject ApiHttpClient Api
@inject IJSRuntime JS

<h2 class="text-xl font-semibold text-gray-900 mb-2">Check your email</h2>
<p class="text-sm text-gray-500 mb-6">
    Enter the 6-digit code sent to <strong>@Email</strong>
</p>

@if (_success)
{
    <div class="rounded-md bg-green-50 border border-green-200 px-4 py-4 text-sm text-green-700">
        <p class="font-medium">Email confirmed successfully!</p>
        <p class="mt-1">Your account is now active. You can sign in.</p>
        <div class="mt-3">
            <a href="/login" class="text-indigo-600 hover:text-indigo-500 font-medium">Sign in →</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
    }

    <div class="flex justify-center gap-2 mb-6" @ref="_container">
        @for (var i = 0; i < 6; i++)
        {
            var idx = i;
            <input
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength="1"
                value="@_digits[idx]"
                @oninput="HandleInput(idx)"
                @onkeydown="HandleKeyDown(idx)"
                @ref="_inputs[idx]"
                class="w-11 h-14 text-center text-xl font-semibold border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
        }
    </div>

    <button @onclick="SubmitAsync" disabled="@(!_allFilled || _loading)" class="btn-primary w-full">
        @(_loading ? "Verifying…" : "Verify code")
    </button>

    <div class="mt-4 text-center">
        <a href="/login" class="text-sm text-indigo-600 hover:text-indigo-500">← Back to sign in</a>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private readonly string[] _digits = new string[6];
    private readonly ElementReference[] _inputs = new ElementReference[6];
    private ElementReference _container;
    private DotNetObjectReference<ConfirmEmail>? _dotNetRef;
    private bool _loading;
    private bool _success;
    private string? _error;

    private bool _allFilled => _digits.All(d => !string.IsNullOrEmpty(d));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initOtpPaste", _container, _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnPaste(string digits)
    {
        for (var i = 0; i < 6; i++)
            _digits[i] = i < digits.Length ? digits[i].ToString() : string.Empty;
        StateHasChanged();
        await JS.InvokeVoidAsync("focusElement", _inputs[Math.Min(digits.Length, 5)]);
    }

    private Func<ChangeEventArgs, Task> HandleInput(int index) => async e =>
    {
        var val = e.Value?.ToString() ?? string.Empty;
        _digits[index] = val.Length > 0 ? val[^1].ToString() : string.Empty;

        if (!string.IsNullOrEmpty(_digits[index]) && index < 5)
            await JS.InvokeVoidAsync("focusElement", _inputs[index + 1]);
    };

    private Func<KeyboardEventArgs, Task> HandleKeyDown(int index) => async e =>
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_digits[index]) && index > 0)
            await JS.InvokeVoidAsync("focusElement", _inputs[index - 1]);
    };

    private async Task SubmitAsync()
    {
        if (!_allFilled) return;

        _error = null;
        _loading = true;
        var code = string.Concat(_digits);
        var error = await Api.ConfirmEmailAsync(Email!, code);
        _success = error is null;
        if (error is not null)
            _error = "The code is invalid or has expired. Please check and try again.";
        _loading = false;
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
