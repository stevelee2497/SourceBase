@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject ApiHttpClient Api

<div class="flex items-center justify-between mb-6">
    <button class="btn-primary" @onclick="OpenCreate" disabled="@_loading">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>New User</span>
    </button>
    <button class="btn-secondary" @onclick="LoadUsersAsync" disabled="@_loading" title="Reload">
        <svg class="w-4 h-4 @(_loading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

@if (_loading)
{
    <div class="text-center py-12 text-gray-400">Loading…</div>
}
else if (_data is not null)
{

    <div class="card p-0 overflow-hidden">
        <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach (var user in _data.Items)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <div class="font-medium text-gray-900 text-sm">@user.UserName</div>
                            <div class="text-xs text-gray-500">@user.Email</div>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-1">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge-blue text-xsm">@role</span>
                                }
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            @if (user.EmailConfirmed)
                            {
                                <span class="badge-green text-xsm">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge-red text-xsm">Pending</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-3">
                                <button class="text-gray-400 hover:text-indigo-600 transition-colors" @onclick="() => OpenEdit(user)" title="Edit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                @if (!user.EmailConfirmed)
                                {
                                    <button class="text-gray-400 hover:text-green-600 transition-colors" @onclick="() => ConfirmUserEmail(user)" title="Confirm Email">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </button>
                                }
                                <button class="text-gray-400 hover:text-amber-600 transition-colors" @onclick="() => OpenResetPassword(user)" title="Reset Password">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                    </svg>
                                </button>
                                <button class="text-gray-400 hover:text-red-600 transition-colors" @onclick="() => ConfirmDelete(user)" title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <Pagination CurrentPage="_page" TotalItems="_data.Total" PageSize="_pageSize" OnPageChanged="ChangePage" />
}

<!-- Create Modal -->
@if (_showCreate)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseCreate"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6 max-h-[90vh] overflow-y-auto">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Create User</h2>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_formError</div>
            }

            <div class="space-y-4">
                <div>
                    <label class="form-label">Username *</label>
                    <input @bind="_form.UserName" class="form-input" placeholder="johndoe" />
                </div>
                <div>
                    <label class="form-label">Password *</label>
                    <input @bind="_form.Password" class="form-input" type="password" placeholder="••••••••" />
                </div>
                <div>
                    <label class="form-label">Email *</label>
                    <input @bind="_form.Email" class="form-input" type="email" placeholder="you@example.com" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label">First name</label>
                        <input @bind="_form.FirstName" class="form-input" placeholder="John" />
                    </div>
                    <div>
                        <label class="form-label">Last name</label>
                        <input @bind="_form.LastName" class="form-input" placeholder="Doe" />
                    </div>
                </div>
                <div>
                    <label class="form-label">Phone number</label>
                    <input @bind="_form.PhoneNumber" class="form-input" type="tel" />
                </div>
                <div>
                    <label class="form-label">Roles</label>
                    <div class="flex flex-wrap gap-2 mt-1">
                        @foreach (var role in _allRoles)
                        {
                            var roleName = role.Name;
                            <label class="flex items-center gap-1.5 text-sm text-gray-700">
                                <input type="checkbox" class="rounded border-gray-300 text-indigo-600"
                                       checked="@_form.SelectedRoles.Contains(roleName)"
                                       @onchange="e => ToggleRole(roleName, (bool)e.Value!)" />
                                @roleName
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button class="btn-secondary" @onclick="CloseCreate">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
                <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" 
                        stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Modal -->
<EditUserModal IsVisible="@_showEdit"
               User="@(_editingUser is null ? null : new UserInfoResponse(_editingUser.Id, _editingUser.UserName, _editingUser.Email, _editingUser.FirstName, _editingUser.LastName, _editingUser.PhoneNumber, _editingUser.Roles.ToArray()))"
               AllRoles="@_allRoles"
               OnClose="@(() => { _showEdit = false; _editingUser = null; })"
               OnSaved="LoadUsersAsync" />

<ConfirmDialog IsVisible="_showDelete" Title="Delete user"
               Message="@($"Are you sure you want to delete '{_deletingUser?.UserName}'? This action cannot be undone.")"
               OnConfirm="DeleteAsync" OnCancel="() => { _showDelete = false; _deletingUser = null; }" />

<!-- Reset Password Modal -->
@if (_showResetPassword)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseResetPassword"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-1">Reset Password</h2>
            <p class="text-sm text-gray-500 mb-4">Resetting password for <strong>@_resetPasswordUser?.UserName</strong>. Copy the password below before submitting — it won't be shown again.</p>

            @if (!string.IsNullOrEmpty(_resetPasswordError))
            {
                <div class="mb-3 rounded-md bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700">@_resetPasswordError</div>
            }

            <div>
                <label class="form-label">New Password</label>
                <div class="flex gap-2">
                    <input @bind="_newPassword" class="form-input flex-1" type="text" readonly />
                    <button class="btn-secondary btn-sm" @onclick="RegeneratePassword">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        Regenerate
                    </button>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-5">
                <button class="btn-secondary" @onclick="CloseResetPassword">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
                <button class="btn-primary" @onclick="SubmitResetPasswordAsync" disabled="@_resettingPassword">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    @(_resettingPassword ? "Sending…" : "Reset & Email")
                </button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="_showConfirmEmail" Title="Confirm email"
               Message="@($"Mark '{_confirmEmailUser?.UserName}' email as confirmed?")"
               ConfirmLabel="Confirm"
               OnConfirm="SubmitConfirmEmailAsync" OnCancel="() => { _showConfirmEmail = false; _confirmEmailUser = null; }" />

@code {
    private PagingResponse<UserResponse>? _data;
    private List<RoleResponse> _allRoles = [];
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private const int _pageSize = 10;

    // Create form state
    private bool _showCreate;
    private readonly UserFormModel _form = new();
    private string? _formError;
    private bool _saving;

    // Edit modal state
    private bool _showEdit;
    private UserResponse? _editingUser;

    // Delete state
    private bool _showDelete;
    private UserResponse? _deletingUser;

    // Reset password state
    private bool _showResetPassword;
    private UserResponse? _resetPasswordUser;
    private string _newPassword = string.Empty;
    private string? _resetPasswordError;
    private bool _resettingPassword;

    // Confirm email state
    private bool _showConfirmEmail;
    private UserResponse? _confirmEmailUser;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUsersAsync(), LoadRolesAsync());
    }

    private async Task LoadUsersAsync()
    {
       _loading = true;
       _error = null;
       var (data, error) = await Api.GetUsersAsync(_page, _pageSize);
       _data = data;
       if (error is not null)
           _error = "Failed to load users.";
       _loading = false;
    }

    private async Task LoadRolesAsync()
    {
       var (result, _) = await Api.GetRolesAsync(1, 100);
            _allRoles = result?.Items ?? [];
    }

    private async Task ChangePage(int page)
    {
        _page = page;
         await LoadUsersAsync();
    }   

    private void OpenCreate()
    {
        _form.Reset();
        _formError = null;
        _showCreate = true;
    }

    private void OpenEdit(UserResponse user)
    {
        _editingUser = user;
        _showEdit = true;
    }

    private void CloseCreate() => _showCreate = false;

    private void ToggleRole(string role, bool selected)
    {
            if (selected) _form.SelectedRoles.Add(role);
        else _form.SelectedRoles.Remove(role);
    }

    private async Task SaveAsync()
    {
        _formError = null;
        _saving = true;
        var error = await Api.CreateUserAsync(_form.UserName, _form.Email, _form.Password, _form.FirstName, _form.LastName, _form.PhoneNumber, _form.SelectedRoles.ToArray());

        if (error is not null)
        {
            _formError = error.Message ?? "Failed to save user. Please try again.";
            _saving = false;
            return;
        }

        _showCreate = false;
        await LoadUsersAsync();
        _saving = false;
    }

    private void ConfirmDelete(UserResponse user)
    {
        _deletingUser = user;
        _showDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (_deletingUser is null) return;
        _showDelete = false;
        var error = await Api.DeleteUserAsync(_deletingUser.Id);
        if (error is not null)
            _error = error.Message ?? "Failed to delete user.";
        else
            await LoadUsersAsync();
        _deletingUser = null;
    }

    private void OpenResetPassword(UserResponse user)
    {
        _resetPasswordUser = user;
        _resetPasswordError = null;
        _newPassword = GeneratePassword();
        _showResetPassword = true;
    }

    private void CloseResetPassword() => _showResetPassword = false;

    private void RegeneratePassword() => _newPassword = GeneratePassword();

    private async Task SubmitResetPasswordAsync()
    {
        _resetPasswordError = null;
        _resettingPassword = true;
        var error = await Api.ResetUserPasswordAsync(_resetPasswordUser!.Id, _newPassword);
        if (error is not null)
        {
            _resetPasswordError = error.Message ?? "Failed to reset password.";
            _resettingPassword = false;
            return;
        }
        _showResetPassword = false;
        _resettingPassword = false;
    }

    private void ConfirmUserEmail(UserResponse user)
    {
        _confirmEmailUser = user;
        _showConfirmEmail = true;
    }

    private async Task SubmitConfirmEmailAsync()
    {
        if (_confirmEmailUser is null) return;
        _showConfirmEmail = false;
        var error = await Api.ConfirmUserEmailAsync(_confirmEmailUser.Id);
        if (error is not null)
            _error = error.Message ?? "Failed to confirm email.";
        else
            await LoadUsersAsync();
        _confirmEmailUser = null;
    }

    private static string GeneratePassword()
    {
        const string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string lower = "abcdefghijklmnopqrstuvwxyz";
        const string digits = "0123456789";
        const string special = "!@#$%^&*";
        const string all = upper + lower + digits + special;
        var rng = new Random();
        var chars = new char[12];
        chars[0] = upper[rng.Next(upper.Length)];
        chars[1] = lower[rng.Next(lower.Length)];
        chars[2] = digits[rng.Next(digits.Length)];
        chars[3] = special[rng.Next(special.Length)];
        for (var i = 4; i < 12; i++)
            chars[i] = all[rng.Next(all.Length)];
        return new string(chars.OrderBy(_ => rng.Next()).ToArray());
    }

    private sealed class UserFormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? PhoneNumber { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = [];

        public void Reset()
        {
            UserName = Email = Password = string.Empty;
            FirstName = LastName = PhoneNumber = null;
            SelectedRoles = [];
        }
    }
}
