@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ApiHttpClient Api
@inject NavigationManager Navigation

<h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Reset your password</h2>
<p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Enter the code from your email and choose a new password.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="space-y-4">
        <div>
            <label class="form-label">Email</label>
            <InputText @bind-Value="_model.Email" class="form-input" type="email" placeholder="you@example.com" autocomplete="email" />
        </div>
        <div>
            <label class="form-label">Reset code</label>
            <InputText @bind-Value="_model.Code" class="form-input" placeholder="6-digit code from email" autocomplete="one-time-code" />
        </div>
        <div>
            <label class="form-label">New password</label>
            <InputText @bind-Value="_model.NewPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Confirm new password</label>
            <InputText @bind-Value="_model.ConfirmPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" />
            @if (!string.IsNullOrEmpty(_model.NewPassword) && _model.NewPassword != _model.ConfirmPassword)
            {
                <p class="form-error">Passwords do not match.</p>
            }
        </div>
    </div>

    <div class="mt-6">
        <button type="submit" class="btn-primary w-full" disabled="@(_loading || (_model.NewPassword != _model.ConfirmPassword))">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            @(_loading ? "Resetting…" : "Reset password")
        </button>
    </div>
</EditForm>

<div class="mt-4 text-center">
    <a href="/login" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300">← Back to sign in</a>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private readonly ResetFormModel _model = new();
    private string? _error;
    private bool _loading;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Email))
            _model.Email = Email;
    }

    private async Task SubmitAsync()
    {
        if (_model.NewPassword != _model.ConfirmPassword) return;

        _error = null;
        _loading = true;
        var error = await Api.ResetPasswordAsync(_model.Email, _model.Code, _model.NewPassword);
        if (error is not null)
        {
            _error = error.Message ?? "Password reset failed. Please try again.";
            _loading = false;
            return;
        }
        Navigation.NavigateTo("/login?reset=1");
        _loading = false;
    }

    private sealed class ResetFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
