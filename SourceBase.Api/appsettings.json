{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedSpecificOrigins": [
    "https://quoctran.qzz.io"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=sourcebase;Username=sourcebase;Password=sourcebase"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AppSettings": {
    "AdminEmail": "admin@yopmail.com",
    "AdminPassword": "",
    "Roles": [
      "Admin",
      "User"
    ],
    "OtpTokenExpirationMinutes": 15,
    "WebUrl": "https://quoctran.qzz.io",
    "SendGridApiKey": "",
    "SendGridAccountOwner": "quoctran2124@gmail.com"
  }
}