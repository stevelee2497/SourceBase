{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "SourceBase.Api"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "dotnet watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "SourceBase.Api"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "group": {
        "kind": "build"
      }
    }
  ]
}