# ── Required ──────────────────────────────────────────────────────────────────
# Seed admin account created on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public URL of this VPS — used for email reset links and CORS
# No trailing slash. Example: http://1.2.3.4
WEB_URL=http://YOUR_VPS_IP

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=sourcebase
POSTGRES_PASSWORD=
POSTGRES_DB=sourcebase

# ── Email (SendGrid) ───────────────────────────────────────────────────────────
# Leave blank to disable outbound email (confirmation codes will only be saved to DB)
SENDGRID_API_KEY=
SENDGRID_ACCOUNT_OWNER=noreply@example.com
