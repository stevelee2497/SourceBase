@page "/time-sheets"
@attribute [Authorize]
@inject ApiHttpClient Api

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
}

<div class="flex flex-col gap-6">

    <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Time Sheets</h2>
        <div class="flex items-center gap-2">
            <button class="btn-secondary btn-sm" @onclick="PrevMonth">&#8249;</button>
            <span class="text-sm font-medium text-gray-700 min-w-32.5 text-center">@_currentDate.ToString("MMMM yyyy")</span>
            <button class="btn-secondary btn-sm" @onclick="NextMonth">&#8250;</button>
        </div>
    </div>

    @if (_loadingSummary)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="card p-4">
            <div class="grid grid-cols-7 gap-1 mb-1">
                @foreach (var dayName in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <div class="text-xs text-center font-medium text-gray-500 py-1">@dayName</div>
                }
            </div>
            <div class="grid grid-cols-7 gap-1">
                @foreach (var cell in _calendarCells)
                {
                    @if (cell is null)
                    {
                        <div class="h-16 rounded"></div>
                    }
                    else
                    {
                        var date = cell.Value;
                        var summary = _summaryByDate.GetValueOrDefault(date);
                        <button class="@GetCellClass(date, summary)" @onclick="OpenDayModal(date)">
                            <span class="text-xs font-bold leading-none">@date.Day</span>
                            @if (summary is not null)
                            {
                                <span class="text-xs mt-0.5 font-medium leading-none">@summary.TotalHours h</span>
                                <span class="hidden md:block text-xs leading-none opacity-75 truncate w-full text-center px-0.5">@string.Join(", ", summary.Projects)</span>
                            }
                            @if (IsSos(date, summary))
                            {
                                <span class="text-xs font-bold leading-none">SOS</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    }

</div>

<!-- Day Modal -->
@if (_showDayModal && _selectedDate is not null)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="CloseDayModal"></div>
        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md mx-4 flex flex-col max-h-[80vh]">

            <!-- Modal header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                <div>
                    <h2 class="text-base font-semibold text-gray-900">@_selectedDate.Value.ToString("dddd, MMMM d")</h2>
                    <p class="text-xs text-gray-400 mt-0.5">@_selectedDate.Value.Year</p>
                </div>
                <button class="text-gray-400 hover:text-gray-600 transition-colors" @onclick="CloseDayModal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Entry list -->
            <div class="overflow-y-auto px-6 py-3 flex-1">
                @if (_loadingDetail)
                {
                    <LoadingSpinner />
                }
                else if (_dayEntries.Count == 0)
                {
                    <p class="text-sm text-gray-400 py-2 text-center">No entries yet. Add one below.</p>
                }
                else
                {
                    @foreach (var entry in _dayEntries)
                    {
                        <div class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
                            <span class="flex-1 text-sm text-gray-800">@entry.Project</span>
                            <span class="text-sm font-medium text-gray-500 shrink-0">@entry.Hours h</span>
                            <button class="text-xs text-gray-400 hover:text-indigo-600 transition-colors shrink-0" @onclick="StartEdit(entry)">Edit</button>
                            <button class="text-xs text-gray-400 hover:text-red-600 transition-colors shrink-0" @onclick="DeleteEntry(entry.Id)">Delete</button>
                        </div>
                    }
                }
            </div>

            <!-- Add / Edit form -->
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 rounded-b-lg">
                <p class="text-xs font-medium text-gray-500 mb-3">
                    @(_editingEntry is null ? "New entry" : $"Editing: {_editingEntry.Project}")
                </p>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="mb-3 rounded-md bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700">@_formError</div>
                }
                <div class="flex gap-2">
                    <input @bind="_formProject" class="form-input flex-1" placeholder="Project name" />
                    <input @bind="_formHours" class="form-input w-24" type="number" step="0.5" min="0.5" max="24" placeholder="Hours" />
                </div>
                <div class="flex justify-end gap-2 mt-3">
                    @if (_editingEntry is not null)
                    {
                        <button class="btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    }
                    <button class="btn-primary btn-sm" @onclick="SaveFormAsync" disabled="@_savingForm">
                        @(_savingForm ? "Saving…" : (_editingEntry is null ? "Add" : "Save"))
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private DateOnly _currentDate = DateOnly.FromDateTime(DateTime.Today).AddDays(1 - DateTime.Today.Day);
    private Dictionary<DateOnly, TimeSheetSummaryDayResponse> _summaryByDate = [];
    private List<DateOnly?> _calendarCells = [];
    private bool _loadingSummary;
    private string? _error;

    private bool _showDayModal;
    private DateOnly? _selectedDate;
    private List<TimeSheetItemResponse> _dayEntries = [];
    private bool _loadingDetail;

    private TimeSheetItemResponse? _editingEntry;
    private string _formProject = string.Empty;
    private decimal _formHours = 8;
    private string? _formError;
    private bool _savingForm;

    protected override async Task OnInitializedAsync() => await LoadSummaryAsync();

    private async Task LoadSummaryAsync()
    {
        _loadingSummary = true;
        _error = null;
        var (data, error) = await Api.GetTimeSheetsAsync(_currentDate.Year, _currentDate.Month);
        if (error is not null)
            _error = error.Message;
        else
            _summaryByDate = (data?.Items ?? [])
                .GroupBy(x => DateOnly.Parse(x.Date))
                .ToDictionary(g => g.Key, g => new TimeSheetSummaryDayResponse(g.Key, g.Sum(x => x.Hours), [.. g.Select(x => x.Project).Order()]));
        BuildCalendarCells();
        _loadingSummary = false;
    }

    private void BuildCalendarCells()
    {
        _calendarCells = [];
        var daysInMonth = DateTime.DaysInMonth(_currentDate.Year, _currentDate.Month);
        var startOffset = ((int)_currentDate.DayOfWeek + 6) % 7;
        for (var i = 0; i < startOffset; i++)
            _calendarCells.Add(null);
        for (var d = 1; d <= daysInMonth; d++)
            _calendarCells.Add(new DateOnly(_currentDate.Year, _currentDate.Month, d));
    }

    private Func<Task> OpenDayModal(DateOnly date) => async () =>
    {
        _selectedDate = date;
        _editingEntry = null;
        _formProject = string.Empty;
        _formHours = 8;
        _formError = null;
        _showDayModal = true;
        await LoadDayDetailAsync();
    };

    private void CloseDayModal()
    {
        _showDayModal = false;
        _selectedDate = null;
        _dayEntries = [];
        _editingEntry = null;
        _formError = null;
    }

    private async Task LoadDayDetailAsync()
    {
        if (_selectedDate is null) return;
        _loadingDetail = true;
        var (data, error) = await Api.GetTimeSheetsAsync(_selectedDate.Value);
        if (error is not null)
            _error = error.Message;
        else
            _dayEntries = data?.Items ?? [];
        _loadingDetail = false;
    }

    private async Task PrevMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        await LoadSummaryAsync();
    }

    private async Task NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        await LoadSummaryAsync();
    }

    private Action StartEdit(TimeSheetItemResponse entry) => () =>
    {
        _editingEntry = entry;
        _formProject = entry.Project;
        _formHours = entry.Hours;
        _formError = null;
    };

    private void CancelEdit()
    {
        _editingEntry = null;
        _formProject = string.Empty;
        _formHours = 8;
        _formError = null;
    }

    private async Task SaveFormAsync()
    {
        if (_selectedDate is null || string.IsNullOrWhiteSpace(_formProject)) return;
        _savingForm = true;
        _formError = null;
        var (_, error) = await Api.UpsertTimeSheetsAsync([new TimeSheetUpsertItem(_selectedDate.Value.ToString("yyyy-MM-dd"), _formProject, _formHours)]);
        _savingForm = false;
        if (error is not null) { _formError = error.Message; return; }
        _editingEntry = null;
        _formProject = string.Empty;
        _formHours = 8;
        await LoadDayDetailAsync();
        await RefreshSummaryAsync();
    }

    private Func<Task> DeleteEntry(Guid id) => async () =>
    {
        var error = await Api.DeleteTimeSheetAsync(id);
        if (error is not null) { _error = error.Message; return; }
        await LoadDayDetailAsync();
        await RefreshSummaryAsync();
    };

    private async Task RefreshSummaryAsync()
    {
        var (data, _) = await Api.GetTimeSheetsAsync(_currentDate.Year, _currentDate.Month);
        _summaryByDate = (data?.Items ?? [])
            .GroupBy(x => DateOnly.Parse(x.Date))
            .ToDictionary(g => g.Key, g => new TimeSheetSummaryDayResponse(g.Key, g.Sum(x => x.Hours), [.. g.Select(x => x.Project).Order()]));
        StateHasChanged();
    }

    private static bool IsSos(DateOnly date, TimeSheetSummaryDayResponse? summary)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var isWeekday = date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday;
        return summary is null && isWeekday && date <= today;
    }

    private string GetCellClass(DateOnly date, TimeSheetSummaryDayResponse? summary)
    {
        if (summary is not null)
            return "h-16 rounded border flex flex-col items-center justify-center p-1 overflow-hidden transition-all cursor-pointer bg-green-50 border-green-200 text-green-800 hover:bg-green-100 hover:shadow-sm";
        if (IsSos(date, summary))
            return "h-16 rounded border flex flex-col items-center justify-center p-1 transition-all cursor-pointer bg-red-50 border-red-200 text-red-700 hover:bg-red-100 hover:shadow-sm";
        return "h-16 rounded border flex flex-col items-center justify-center p-1 transition-all cursor-pointer bg-gray-50 border-gray-200 text-gray-500 hover:bg-gray-100 hover:shadow-sm";
    }
}
