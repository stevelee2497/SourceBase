@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject HttpClient Http

<h2 class="text-xl font-semibold text-gray-900 mb-2">Forgot your password?</h2>
<p class="text-sm text-gray-500 mb-6">Enter your email and we'll send you a reset code.</p>

@if (_success)
{
    <div class="rounded-md bg-green-50 border border-green-200 px-4 py-4 text-sm text-green-700">
        <p class="font-medium">Check your email</p>
        <p class="mt-1">If an account with that email exists, we've sent a password reset code.</p>
        <div class="mt-3">
            <a href="/reset-password?email=@Uri.EscapeDataString(_email)" class="text-indigo-600 hover:text-indigo-500 font-medium">Enter reset code →</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <div class="space-y-4">
            <div>
                <label class="form-label">Email</label>
                <InputText @bind-Value="_model.Email" class="form-input" type="email" placeholder="you@example.com" autocomplete="email" />
            </div>
        </div>

        <div class="mt-6">
            <button type="submit" class="btn-primary w-full" disabled="@_loading">
                @if (_loading)
                {
                    <span>Sending…</span>
                }
                else
                {

                    <span>Send reset code</span>
                }
            </button>
        </div>
    </EditForm>
}

<div class="mt-4 text-center">
    <a href="/login" class="text-sm text-indigo-600 hover:text-indigo-500">← Back to sign in</a>
</div>

@code {
    private readonly ForgotFormModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _success;
    private string _email = string.Empty;

    private async Task SubmitAsync()
    {
        _error = null;
        _loading = true;
        _email = _model.Email;
        try
        {
            await Http.PostAsJsonAsync("/api/auth/forgotPassword", new { email = _model.Email });
            _success = true;
        }
        catch
        {
            // Show success anyway to avoid leaking whether an account exists
            _success = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ForgotFormModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
