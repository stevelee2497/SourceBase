@inject ApiHttpClient Api
@inject NavigationManager Navigation
@inject AppSettings AppSettings

@if (IsVisible)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40" @onclick="HandleClose"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-lg mx-4 p-6 max-h-[90vh] overflow-y-auto">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">@(_isCreate ? "Create User" : "Edit User")</h2>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
            }

            <div class="space-y-4">
                @if (!_isCreate)
                {
                    <div>
                        <label class="form-label">Avatar</label>
                        <div class="flex items-center gap-4 mt-1">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-gray-100 dark:bg-gray-700/50 flex items-center justify-center shrink-0">
                                @if (!string.IsNullOrEmpty(_form.AvatarUrl))
                                {
                                    <img src="@_form.AvatarUrl" alt="Avatar" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                }
                            </div>
                            <div class="flex-1">
                                <InputFile OnChange="UploadAvatarAsync" accept="image/jpeg,image/png,image/gif,image/webp" class="block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-indigo-50 dark:file:bg-indigo-900/30 file:text-indigo-700 dark:file:text-indigo-400 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/40" disabled="@_uploadingAvatar" />
                                @if (_uploadingAvatar)
                                {
                                    <p class="text-xs text-indigo-600 dark:text-indigo-400 mt-1">Uploading…</p>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (_isCreate)
                {
                    <div>
                        <label class="form-label">Username *</label>
                        <input @bind="_form.UserName" class="form-input" placeholder="johndoe" />
                    </div>
                    <div>
                        <label class="form-label">Password *</label>
                        <input @bind="_form.Password" class="form-input" type="password" placeholder="••••••••" />
                    </div>
                }
                <div>
                    <label class="form-label">Email *</label>
                    <input @bind="_form.Email" class="form-input" type="email" placeholder="you@example.com" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label">First name</label>
                        <input @bind="_form.FirstName" class="form-input" placeholder="John" />
                    </div>
                    <div>
                        <label class="form-label">Last name</label>
                        <input @bind="_form.LastName" class="form-input" placeholder="Doe" />
                    </div>
                </div>
                <div>
                    <label class="form-label">Phone number</label>
                    <input @bind="_form.PhoneNumber" class="form-input" type="tel" />
                </div>
                @if (AllRoles.Count > 0)
                {
                    <div>
                        <label class="form-label">Roles</label>
                        <div class="flex flex-wrap gap-2 mt-1">
                            @foreach (var role in AllRoles)
                            {
                                var roleName = role.Name;
                                <label class="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-200">
                                    <input type="checkbox" class="rounded border-gray-300 dark:border-gray-600 text-indigo-600 dark:bg-gray-700" checked="@_form.SelectedRoles.Contains(roleName)" @onchange="e => ToggleRole(roleName, (bool)e.Value!)" />
                                    @roleName
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (IsSelfEdit && !_isCreate)
            {
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                    <p class="form-label mb-2">Connected Accounts</p>
                    <div class="flex items-center justify-between rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2.5">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                            </svg>
                            <span class="text-sm text-gray-700 dark:text-gray-200">Google</span>
                        </div>
                        @if (User?.IsGoogleConnected == true)
                        {
                            <button type="button" class="btn-danger btn-sm" @onclick="DisconnectGoogleAsync" disabled="@_googleLoading">
                                @(_googleLoading ? "Disconnecting…" : "Disconnect")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-secondary btn-sm" @onclick="ConnectGoogleAsync" disabled="@_googleLoading">
                                @(_googleLoading ? "Connecting…" : "Connect")
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="flex justify-end gap-3 mt-6">
                <button class="btn-secondary" @onclick="HandleClose">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
                <button class="btn-primary" @onclick="SaveAsync" disabled="@(_saving || _uploadingAvatar)">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool IsVisible { get; set; }
    [Parameter] public bool IsSelfEdit { get; set; }
    [Parameter] public UserInfoResponse? User { get; set; }
    [Parameter] public List<RoleResponse> AllRoles { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _isCreate => User is null;
    private bool _prevIsVisible;
    private readonly FormModel _form = new();
    private string? _error;
    private bool _saving;
    private bool _uploadingAvatar;
    private bool _googleLoading;

    protected override void OnParametersSet()
    {
        if (IsVisible && !_prevIsVisible)
        {
            _form.UserName = string.Empty;
            _form.Password = string.Empty;
            _form.Email = User?.Email ?? string.Empty;
            _form.FirstName = User?.FirstName;
            _form.LastName = User?.LastName;
            _form.PhoneNumber = User?.PhoneNumber;
            _form.AvatarUrl = User?.AvatarUrl;
            _form.SelectedRoles = [.. User?.Roles ?? []];
            _error = null;
        }
        _prevIsVisible = IsVisible;
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected) _form.SelectedRoles.Add(role);
        else _form.SelectedRoles.Remove(role);
    }

    private async Task UploadAvatarAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _uploadingAvatar = true;
        _error = null;

        var (uploadInfo, urlError) = await Api.GetAvatarUploadUrlAsync(file.Name);
        if (urlError is not null || uploadInfo is null)
        {
            _error = urlError?.Message ?? "Failed to get upload URL.";
            _uploadingAvatar = false;
            return;
        }

        var error = await Api.PerformAvatarUploadAsync(file, uploadInfo);
        if (error is not null)
        {
            _error = error;
        }
        _form.AvatarUrl = uploadInfo.AvatarUrl;
        _uploadingAvatar = false;
    }

  

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;

        ErrorResponse? error;
        if (_isCreate)
            error = await Api.CreateUserAsync(_form.UserName, _form.Email, _form.Password, _form.FirstName, _form.LastName, _form.PhoneNumber, [.. _form.SelectedRoles]);
        else
            error = await Api.UpdateUserAsync(User!.Id, _form.Email, _form.FirstName, _form.LastName, _form.PhoneNumber, _form.AvatarUrl, [.. _form.SelectedRoles]);

        if (error is not null)
        {
            _error = error.Message ?? "Failed to save user. Please try again.";
            _saving = false;
            return;
        }
        _saving = false;
        await OnSaved.InvokeAsync();
    }

    private Task HandleClose() => OnClose.InvokeAsync();

    private async Task ConnectGoogleAsync()
    {
        _googleLoading = true;
        var (result, error) = await Api.PrepareGoogleConnectAsync();
        _googleLoading = false;
        if (error is not null || result is null) { _error = error?.Message ?? "Failed to initiate Google connection."; return; }
        Navigation.NavigateTo($"{AppSettings.FullApiBaseUrl}/api/auth/google/connect?state={Uri.EscapeDataString(result.State)}", forceLoad: true);
    }

    private async Task DisconnectGoogleAsync()
    {
        _googleLoading = true;
        var error = await Api.DisconnectGoogleAsync();
        _googleLoading = false;
        if (error is not null) { _error = error.Message ?? "Failed to disconnect Google."; return; }
        await OnSaved.InvokeAsync();
    }

    private sealed class FormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? PhoneNumber { get; set; }
        public string? AvatarUrl { get; set; }
        public HashSet<string> SelectedRoles { get; set; } = [];
    }
}
