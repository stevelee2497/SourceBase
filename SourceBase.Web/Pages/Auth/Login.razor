@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ApiHttpClient Api
@inject BlazorAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AppSettings AppSettings

<h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Sign in to your account</h2>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 px-4 py-3 text-sm text-red-700 dark:text-red-400">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="space-y-4">
        <div>
            <label class="form-label" for="email">Email</label>
            <InputText id="email" @bind-Value="_model.Email" class="form-input" type="email" placeholder="you@example.com" autocomplete="email" />
        </div>
        <div>
            <label class="form-label" for="password">Password</label>
            <InputText id="password" @bind-Value="_model.Password" class="form-input" type="password" placeholder="••••••••" autocomplete="current-password" />
        </div>
    </div>

    <div class="mt-6">
        <button type="submit" class="btn-primary w-full" disabled="@_loading">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            @(_loading ? "Signing in…" : "Sign in")
        </button>
    </div>
</EditForm>

<div class="mt-3 flex items-center gap-3">
    <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
    <span class="text-xs text-gray-400 dark:text-gray-500">or</span>
    <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
</div>

<div class="mt-3">
    <button type="button" class="btn-secondary w-full flex items-center justify-center gap-2" @onclick="SignInWithGoogle">
        <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Continue with Google
    </button>
</div>

<div class="mt-4 flex flex-col gap-2 text-center text-sm">
    <a href="/forgot-password" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500">Forgot your password?</a>
    <span class="text-gray-500 dark:text-gray-400">No account? <a href="/register" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-500">Sign
        up</a></span>
    </div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _error;
    private bool _loading;

    private async Task SubmitAsync()
    {
        _error = null;
        _loading = true;
        var (tokens, error) = await Api.LoginAsync(_model.Email, _model.Password);
        if (error is not null)
        {
            _error = error.Message ?? "Login failed. Please check your credentials and try again.";
            _loading = false;
            return;
        }

        await AuthStateProvider.SetTokensAsync(tokens!);

        var (userInfo, userInfoError) = await Api.GetUserInfoAsync();
        if (userInfoError is not null || userInfo is null)
        {
            _error = userInfoError?.Message ?? "An unexpected error occurred. Please try again.";
            _loading = false;
            return;
        }

        AuthStateProvider.SetUserInfo(userInfo);
        _loading = false;
        Navigation.NavigateTo("/");
    }

    private void SignInWithGoogle() =>
        Navigation.NavigateTo($"{AppSettings.FullApiBaseUrl}/api/auth/google", forceLoad: true);

    private sealed class LoginFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

}
