{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/app.ts",
    "src/index.ts",
    "src/types.ts",
    "src/lib/**/*.ts",
    "src/testing/**/*.ts",
    "src/routes/auth/**/*.ts",
    "src/routes/todo-lists/**/*.ts",
    "src/routes/todos/**/*.ts",
    "src/routes/time-sheets/**/*.ts",
    "tests/auth.test.ts",
    "tests/todo-lists.test.ts",
    "tests/todos.test.ts",
    "tests/time-sheets.test.ts",
    "tests/support/**/*.ts",
    "vitest.config.ts"
  ]
}
