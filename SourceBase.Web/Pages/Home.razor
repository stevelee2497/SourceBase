@page "/"
@attribute [Authorize]
@inject BlazorAuthStateProvider Auth

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Dashboard</h1>
    <p class="mt-1 text-sm text-gray-500">Welcome back, @Auth.UserInfo?.UserName</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="card">
        <div class="text-sm font-medium text-gray-500 mb-1">Email</div>
        <div class="text-gray-900">@(Auth.UserInfo?.Email ?? "—")</div>
    </div>
    <div class="card">
        <div class="text-sm font-medium text-gray-500 mb-1">Roles</div>
        <div class="flex flex-wrap gap-1">
            @foreach (var role in Auth.UserInfo?.Roles ?? [])
            {
                <span class="badge-blue">@role</span>
            }
        </div>
    </div>
</div>

<AuthorizeView Roles="Admin">
    <div class="mt-8">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Quick Actions</h2>
        <div class="flex gap-3">
            <a href="/users" class="btn-primary">Manage Users</a>
            <a href="/roles" class="btn-secondary">Manage Roles</a>
        </div>
    </div>
</AuthorizeView>
